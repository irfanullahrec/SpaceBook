<text x="50" y="89">0</text><text x="110" y="89">1</text><text x="170" y="89">0</text><text x="230" y="89">0</text><text x="290" y="89">0</text><text x="350" y="89">0</text><text x="410" y="89">0</text><text x="470" y="89">1</text>
