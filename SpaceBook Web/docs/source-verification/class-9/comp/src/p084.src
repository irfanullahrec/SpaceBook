### Program 3.14 || پروگرام 3.14 || پروګرام ۳.۱۴
m #include<stdio.h>
m void main()
m {
m     char ch='A';
m     printf("Character=%c\n",ch); // Here %c will be replaced with the value of ch
m }
box teach | SAMPLE OUTPUT || نمونہ آؤٹ پٹ || نمونه output
m Character=A
