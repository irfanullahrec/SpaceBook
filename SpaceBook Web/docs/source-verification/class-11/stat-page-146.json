    },
    {
      "id": "stat11-s146-k1",
      "en": "The difference between values of a variable around an average value is called dispersion.",
      "ur": "کسی اوسط قدر کے گرد متغیر کی قدروں کے درمیان فرق انتشار کہلاتا ہے۔",
      "ps": "د یوه اوسط ارزښت شاوخوا د متغیر د ارزښتونو ترمنځ توپیر خپراوی بلل کېږي.",
      "listGroup": "unit3-key-points-1"
    },
    {
      "id": "stat11-s146-k2",
      "en": "The difference between largest and smallest observations in a data set is called range.",
      "ur": "اعداد و شمار کے مجموعے میں سب سے بڑے اور سب سے چھوٹے مشاہدات کا فرق حد (رینج) کہلاتا ہے۔",
      "ps": "په معلوماتو ټولګه کې د تر ټولو لوی او تر ټولو کوچني کتنو توپیر رېنج بلل کېږي.",
      "listGroup": "unit3-key-points-1"
    },
    {
      "id": "stat11-s146-k3",
      "en": "The difference between third and first quartiles divided by 2 is called quartile deviation.",
      "ur": "تیسری اور پہلی چوتھائی کے فرق کو 2 پر تقسیم کرنا چوتھائی انحراف کہلاتا ہے۔",
      "ps": "د دریمې او لومړۍ څلورمې توپیر چې پر 2 وویشل شي څلورمه انحراف بلل کېږي.",
      "listGroup": "unit3-key-points-1"
    },
    {
      "id": "stat11-s146-k4",
      "en": "The arithmetic mean of the absolute or mod deviations of observations taken from mean or median or mode is called mean deviation.",
      "ur": "اوسط یا وسطانیہ یا عادہ سے لیے گئے مشاہدات کے مطلق یا ماڈ انحرافات کا حسابی اوسط اوسط انحراف کہلاتا ہے۔",
      "ps": "د اوسط یا میانې یا مود څخه اخیستل شویو کتنو د مطلقو یا مود انحرافاتو حسابي اوسط اوسط انحراف بلل کېږي.",
      "listGroup": "unit3-key-points-1"
    },
    {
      "id": "stat11-s146-k5",
      "en": "The positive square root of the average of the squared deviations of observations taken from mean is called standard deviation.",
      "ur": "اوسط سے لیے گئے مشاہدات کے مربع انحرافات کے اوسط کا مثبت جذر معیاری انحراف کہلاتا ہے۔",
      "ps": "له اوسط څخه اخیستل شویو کتنو د مربع انحرافاتو د اوسط مثبت جذر معیاري انحراف بلل کېږي.",
      "listGroup": "unit3-key-points-1"
    },
    {
      "id": "stat11-s146-l1",
      "en": "Population standard deviation: (Parameter)",
      "ur": "آبادی کا معیاری انحراف: (پیرامیٹر)",
      "ps": "د ټولنې معیاري انحراف: (پارامېټر)",
      "listGroup": "unit3-key-points-2"
    },
    {
      "id": "stat11-s146-l2",
      "en": "Sample standard deviation (biased): (Statistic)",
      "ur": "نمونے کا معیاری انحراف (متعصب): (شماریہ)",
      "ps": "د نمونې معیاري انحراف (تعصب لرونکی): (احصایه)",
      "listGroup": "unit3-key-points-2"
    },
    {
      "id": "stat11-s146-l3",
      "en": "Sample standard deviation (unbiased): (Statistic)",
      "ur": "نمونے کا معیاری انحراف (غیر متعصب): (شماریہ)",
      "ps": "د نمونې معیاري انحراف (بې‌تعصبه): (احصایه)",
      "listGroup": "unit3-key-points-2"
    },
    {
      "id": "stat11-s146-k6",
      "en": "Variance is the square of the S.D.",
      "ur": "تغیر S.D کا مربع ہے۔",
      "ps": "وریانس د S.D مربع دی.",
      "listGroup": "unit3-key-points-3"
    },
    {
      "id": "stat11-s146-k7",
      "en": "The ratio of S.D and the mean expressed in percentage is called coefficient of variation.",
      "ur": "S.D اور اوسط کی نسبت جو فیصد میں ظاہر کی جائے تغیر کا عددی سر کہلاتی ہے۔",
      "ps": "د S.D او اوسط نسبت چې په سلنه کې ښودل شي د تغیر ضریب بلل کېږي.",
      "listGroup": "unit3-key-points-3"
    },
    {
      "id": "stat11-s146-k8",
      "en": "The lack of symmetry is called skewness.",
      "ur": "تشاکل کی کمی کو کجی کہتے ہیں۔",
      "ps": "د تناسب نشتوالی ته کوړوالی ویل کېږي.",
      "listGroup": "unit3-key-points-3"
    },
    {
      "id": "stat11-s146-p",
      "en": "The Pearsonian coefficient of skewness,",
      "ur": "کجی کا پیئرسنی عددی سر،",
      "ps": "د کوړوالي پیرسني ضریب،",
      "listGroup": "unit3-key-points-4"
    },
    {
      "id": "stat11-s146-b",
      "en": "The Bowley coefficient of skewness",
      "ur": "کجی کا باؤلے عددی سر",
      "ps": "د کوړوالي بولي ضریب",
      "listGroup": "unit3-key-points-4"
    },
    {
      "id": "stat11-s146-k9",
      "en": "Kurtosis means the peakedness or flatness of the graph of a frequency distribution as compared to the normal curve.",
      "ur": "نوکیلا پن تعدد تقسیم کے گراف کا نارمل منحنی کے مقابلے میں نوکیلا یا چپٹا ہونا ہے۔",
      "ps": "تېزوالی د فریکونسي ویش د ګراف د نورمال منحني په پرتله تېز یا چپټ والی دی.",
      "listGroup": "unit3-key-points-5"
    }
