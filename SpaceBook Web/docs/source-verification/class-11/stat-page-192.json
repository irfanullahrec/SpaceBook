  "paras": [
    {
      "id": "stat11-s192-i1",
      "en": "Interpretation of the Coefficient of Correlation: The numerical value indicates the strength of the relationship while the sign only indicates direction of the relationship.",
      "ur": "ارتباط کے عددی سر کی تشریح: عددی قدر تعلق کی مضبوطی ظاہر کرتی ہے جبکہ علامت صرف تعلق کی سمت ظاہر کرتی ہے۔",
      "ps": "د همتړاو د ضریب تفسیر: عددي ارزښت د اړیکې ځواک ښيي پداسې حال کې چې نښه یوازې د اړیکې لوری ښيي."
    },
    {
      "id": "stat11-s192-i2",
      "en": "If r_xy = 0 means correlation is zero i.e. x and y are uncorrelated.",
      "ur": "اگر r_xy = 0 ہو تو مطلب ارتباط صفر ہے یعنی x اور y غیر مربوط ہیں۔",
      "ps": "که r_xy = 0 وي نو پدې معنا چې همتړاو صفر دی یعنې x او y غیر همتړي دي."
    },
    {
      "id": "stat11-s192-i3",
      "en": "> 0 means correlation is positive.",
      "ur": "> 0 کا مطلب ارتباط مثبت ہے۔",
      "ps": "> 0 پدې معنا چې همتړاو مثبت دی."
    },
    {
      "id": "stat11-s192-i4",
      "en": "< 0 means correlation is negative.",
      "ur": "< 0 کا مطلب ارتباط منفی ہے۔",
      "ps": "< 0 پدې معنا چې همتړاو منفي دی."
    },
    {
      "id": "stat11-s192-i5",
      "en": "= 1 means there is perfect positive correlation.",
      "ur": "= 1 کا مطلب کامل مثبت ارتباط ہے۔",
      "ps": "= 1 پدې معنا چې بشپړ مثبت همتړاو دی."
    },
    {
      "id": "stat11-s192-i6",
      "en": "= −1 means there is perfect negative correlation.",
      "ur": "= −1 کا مطلب کامل منفی ارتباط ہے۔",
      "ps": "= −1 پدې معنا چې بشپړ منفي همتړاو دی."
    },
    {
      "id": "stat11-s192-ex53",
