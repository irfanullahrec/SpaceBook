  "equations": [
    {
      "id": "stat11-s192-sh",
      "latex": "\\text{or}\\quad r_{xy}=\\dfrac{n\\sum xy-\\sum x\\sum y}{\\sqrt{\\left[n\\sum x^2-\\left(\\sum x\\right)^2\\right]\\left[n\\sum y^2-\\left(\\sum y\\right)^2\\right]}}\\qquad\\text{(Shortcut method)}",
      "accessible": "or r_xy = (nΣxy − ΣxΣy) / √([nΣx² − (Σx)²][nΣy² − (Σy)²])   (Shortcut method)",
      "nativeLines": {
        "en": [
          [
            {
              "text": "or r_xy = (nΣxy − ΣxΣy) / √([nΣx² − (Σx)²][nΣy² − (Σy)²])   (Shortcut method)"
            }
          ]
        ],
        "ur": [
          [
            {
              "text": "or r_xy = (nΣxy − ΣxΣy) / √([nΣx² − (Σx)²][nΣy² − (Σy)²])   (Shortcut method)"
