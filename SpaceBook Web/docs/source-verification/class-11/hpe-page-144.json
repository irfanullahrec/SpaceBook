    {
      "id": "hpe11-s144-p1",
      "en": "For example, if the number of teams is 5, then",
      "ur": "مثلاً اگر ٹیموں کی تعداد 5 ہو تو",
      "ps": "د بېلګې په توګه که د ټیمونو شمېر ۵ وي نو"
    },
    {
      "id": "hpe11-s144-p2",
      "en": "Total matches = ((5−1)×5) ÷ 2 = (4×5) ÷ 2 = 20 ÷ 2 = 10",
      "ur": "کل میچ = (5−1)×5 ÷ 2 = (4×5) ÷ 2 = 20 ÷ 2 = 10",
      "ps": "ټولې لوبې = ((۵−۱)×۵) ÷ ۲ = (۴×۵) ÷ ۲ = ۲۰ ÷ ۲ = ۱۰",
      "sourceGap": {
        "note": "Printed as “5−1×5”; the evaluation 4×5 = 20 and 20/2 = 10 shows the intended product (5−1)×5."
      }
    },
    {
      "id": "hpe11-s144-p3",
      "en": "Fixture of 5 teams’ matches under this system",
      "ur": "اس سسٹم کے تحت 5 میچوں کا فکسچر",
      "ps": "د دې سیسټم لاندې د ۵ ټیمونو د لوبو فکسچر"
    },
    {
      "id": "hpe11-s144-p4",
      "en": "Total matches = ((6−1)×6) ÷ 2 = (5×6) ÷ 2 = 30 ÷ 2 = 15. The fixture of 6 teams under the league system is as follows.",
      "ur": "کل میچ = (6−1)×6 ÷ 2 = (5×6) ÷ 2 = 30 ÷ 2 = 15۔ لیگ سسٹم کے تحت 6 ٹیموں کا فکسچر مندرجہ ذیل ہے۔",
      "ps": "ټولې لوبې = ((۶−۱)×۶) ÷ ۲ = (۵×۶) ÷ ۲ = ۳۰ ÷ ۲ = ۱۵. د لیګ سیسټم لاندې د ۶ ټیمونو فکسچر په لاندې ډول دی."
    }
  ],
