  "auditStatus": "corrected; verification pending",
  "paras": [
    {
      "id": "chem11-p254-e1",
      "en": "Example 8.1",
      "ur": "مثال 8.1",
      "ps": "بېلګه 8.1",
      "kind": "heading"
    },
    {
      "id": "chem11-p254-q1",
      "en": "What is the pH and pOH of 0.001 M HCl solution?",
      "ur": "0.001 M HCl محلول کا pH اور pOH کیا ہے؟",
      "ps": "د 0.001 M HCl محلول pH او pOH څومره دی؟"
    },
    {
      "id": "chem11-p254-s1",
      "en": "Solution",
      "ur": "حل",
      "ps": "حل",
      "kind": "heading"
    },
    {
      "id": "chem11-p254-a1",
      "en": "The concentration of HCl = 0.001 = 10⁻³",
      "ur": "HCl کا ارتکاز = 0.001 = 10⁻³",
      "ps": "د HCl غلظت = 0.001 = 10⁻³"
    },
    {
      "id": "chem11-p254-a2",
      "en": "You can write as, [H⁺] = 10⁻³",
      "ur": "آپ لکھ سکتے ہیں، [H⁺] = 10⁻³",
      "ps": "تاسو لیکلای شئ، [H⁺] = 10⁻³"
    },
    {
      "id": "chem11-p254-a3",
      "en": "Taking negative log (– log) of both sides, you have,",
      "ur": "دونوں اطراف کا منفی لوگ (– log) لینے پر ہمیں ملتا ہے،",
      "ps": "د دواړو اړخونو منفي لوګ (– log) اخیستلو سره تاسو ترلاسه کوئ،"
    },
    {
      "id": "chem11-p254-a4",
      "en": "As you have,",
      "ur": "جیسا کہ آپ کے پاس ہے،",
      "ps": "لکه څنګه چې تاسو لرئ،"
    },
    {
      "id": "chem11-p254-a5",
      "en": "– log [H⁺] = pH, so you can write,",
      "ur": "– log [H⁺] = pH، لہٰذا آپ لکھ سکتے ہیں،",
      "ps": "– log [H⁺] = pH، نو تاسو لیکلای شئ،"
    },
    {
      "id": "chem11-p254-a6",
      "en": "Since, you have equation (8.8),",
      "ur": "چونکہ آپ کے پاس مساوات (8.8) ہے،",
      "ps": "ځکه چې تاسو معادله (8.8) لرئ،"
    },
    {
      "id": "chem11-p254-a7",
      "en": "or",
      "ur": "یا",
      "ps": "یا"
    },
    {
      "id": "chem11-p254-e2",
      "en": "Example 8.2",
      "ur": "مثال 8.2",
      "ps": "بېلګه 8.2",
      "kind": "heading"
    },
    {
      "id": "chem11-p254-q2",
      "en": "Determine the pH of 0.15M NaOH solution.",
      "ur": "0.15M NaOH محلول کا pH معلوم کریں۔",
      "ps": "د 0.15M NaOH محلول pH وټاکئ."
    },
    {
      "id": "chem11-p254-s2",
      "en": "Solution",
      "ur": "حل",
      "ps": "حل",
      "kind": "heading"
    },
    {
      "id": "chem11-p254-b1",
      "en": "The concentration of NaOH = 0.15 = 1.5 × 10⁻¹",
      "ur": "NaOH کا ارتکاز = 0.15 = 1.5 × 10⁻¹",
      "ps": "د NaOH غلظت = 0.15 = 1.5 × 10⁻¹"
    },
    {
      "id": "chem11-p254-b2",
      "en": "You can write as, [OH⁻] = 1.5 × 10⁻¹",
      "ur": "آپ لکھ سکتے ہیں، [OH⁻] = 1.5 × 10⁻¹",
      "ps": "تاسو لیکلای شئ، [OH⁻] = 1.5 × 10⁻¹"
    },
    {
      "id": "chem11-p254-b3",
      "en": "Taking negative log (–log) of both sides, you have,",
      "ur": "دونوں اطراف کا منفی لوگ (–log) لینے پر ہمیں ملتا ہے،",
      "ps": "د دواړو اړخونو منفي لوګ (–log) اخیستلو سره تاسو ترلاسه کوئ،"
    },
    {
      "id": "chem11-p254-b4",
      "en": "Or you can write, pOH = 0.8",
      "ur": "یا آپ لکھ سکتے ہیں، pOH = 0.8",
      "ps": "یا تاسو لیکلای شئ، pOH = 0.8"
    },
    {
      "id": "chem11-p254-b5",
      "en": "as you have,",
      "ur": "جیسا کہ آپ کے پاس ہے،",
      "ps": "لکه څنګه چې تاسو لرئ،"
    },
    {
      "id": "chem11-p254-b6",
      "en": "or",
      "ur": "یا",
      "ps": "یا"
    }
  ],
