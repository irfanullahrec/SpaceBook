  "paras": [
    {
      "id": "chem11-p282-h2932",
      "en": "9.2.3.2 Second Order Reactions",
      "ur": "9.2.3.2 دوسرے درجے کے تعاملات",
      "ps": "9.2.3.2 دویمې درجې تعاملات",
      "kind": "heading"
    },
    {
      "id": "chem11-p282-a1",
      "en": "The reactions for which the rate of the reaction is proportional to the second power of concentrations of reactants are second order reactions.",
      "ur": "وہ تعاملات جن کی شرح تعامل کنندگان کے ارتکاز کی دوسری قوت کے متناسب ہو دوسرے درجے کے تعاملات ہیں۔",
      "ps": "هغه تعاملات چې د تعامل چټکتیا یې د متعاملینو د غلظت د دویم توان سره متناسبه وي دویمې درجې تعاملات دي."
    },
    {
      "id": "chem11-p282-a2",
      "en": "It is a second order reaction because the rate of reaction is proportional to the second power of concentration of the reactant.",
      "ur": "یہ دوسرے درجے کا تعامل ہے کیونکہ تعامل کی شرح تعامل کنندہ کے ارتکاز کی دوسری قوت کے متناسب ہے۔",
      "ps": "دا دویمې درجې تعامل دی ځکه چې د تعامل چټکتیا د متعامل د غلظت د دویم توان سره متناسبه ده."
    },
    {
      "id": "chem11-p282-e91",
      "en": "Example: 9.1",
      "ur": "مثال: 9.1",
      "ps": "بېلګه: 9.1",
      "kind": "heading"
    },
    {
      "id": "chem11-p282-b1",
      "en": "(i) Thermal decomposition of nitrogen dioxide,",
      "ur": "(i) نائٹروجن ڈائی آکسائیڈ کی حرارتی تحلیل،",
      "ps": "(i) د نایټروجن ډای اکسایډ تودوخیزه تجزیه،"
    },
    {
      "id": "chem11-p282-b2",
      "en": "(ii) Thermal decomposition of hydrogen iodide",
      "ur": "(ii) ہائیڈروجن آئیوڈائیڈ کی حرارتی تحلیل",
      "ps": "(ii) د هایدروجن آیوډایډ تودوخیزه تجزیه"
    },
    {
      "id": "chem11-p282-b3",
      "en": "The second order reaction can also be represented in general form as",
      "ur": "دوسرے درجے کے تعامل کو عمومی شکل میں بھی ظاہر کیا جا سکتا ہے",
      "ps": "دویمې درجې تعامل په عمومي بڼه کې هم ښودل کېدای شي"
    },
    {
      "id": "chem11-p282-b4",
      "en": "It is a second order reaction because the rate of reaction is proportional to the concentrations of two reactants A and B each raised to the first power.",
      "ur": "یہ دوسرے درجے کا تعامل ہے کیونکہ تعامل کی شرح دو تعامل کنندگان A اور B کے ارتکازوں کے متناسب ہے جن میں سے ہر ایک کو پہلی قوت تک بڑھایا گیا ہے۔",
      "ps": "دا دویمې درجې تعامل دی ځکه چې د تعامل چټکتیا د دوو متعاملینو A او B د غلظتونو سره متناسبه ده چې هر یو یې لومړي توان ته پورته شوی دی."
    },
    {
      "id": "chem11-p282-e92",
      "en": "Example: 9.2",
      "ur": "مثال: 9.2",
      "ps": "بېلګه: 9.2",
      "kind": "heading"
    },
    {
      "id": "chem11-p282-c1",
      "en": "(i) Formation of hydrogen iodide from hydrogen and iodine.",
      "ur": "(i) ہائیڈروجن اور آئیوڈین سے ہائیڈروجن آئیوڈائیڈ کی تشکیل۔",
      "ps": "(i) له هایدروجن او آیوډین څخه د هایدروجن آیوډایډ جوړېدل."
    },
    {
      "id": "chem11-p282-h2933",
      "en": "9.2.3.3 Third Order Reactions",
      "ur": "9.2.3.3 تیسرے درجے کے تعاملات",
      "ps": "9.2.3.3 دریمې درجې تعاملات",
      "kind": "heading"
    },
    {
      "id": "chem11-p282-d1",
      "en": "Those reactions for which the rate of reaction is proportional to the third power of concentrations of reactants. It can be represented as",
      "ur": "وہ تعاملات جن کی شرح تعامل کنندگان کے ارتکاز کی تیسری قوت کے متناسب ہو۔ اسے اس طرح ظاہر کیا جا سکتا ہے",
      "ps": "هغه تعاملات چې د تعامل چټکتیا یې د متعاملینو د غلظت د دریم توان سره متناسبه وي. دا داسې ښودل کېدای شي"
    },
    {
      "id": "chem11-p282-d2",
      "en": "And rate of the reaction is given as follows",
      "ur": "اور تعامل کی شرح اس طرح دی جاتی ہے",
      "ps": "او د تعامل چټکتیا په لاندې ډول ورکول کېږي"
    }
  ],
