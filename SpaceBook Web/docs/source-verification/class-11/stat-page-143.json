    {
      "id": "stat11-s143-h38",
      "en": "3.8 Kurtosis",
      "ur": "3.8 نوکیلا پن",
      "ps": "3.8 تېزوالی",
      "kind": "heading"
    },
    {
      "id": "stat11-s143-t38",
      "en": "Kurtosis is a Greek word introduced by Karl Pearson. It means the peakedness or flatness of the graph of a frequency distribution as compared to the normal curve.",
      "ur": "نوکیلا پن ایک یونانی لفظ ہے جسے کارل پیئرسن نے متعارف کرایا۔ اس کا مطلب تعدد تقسیم کے گراف کا نارمل منحنی کے مقابلے میں نوکیلا یا چپٹا ہونا ہے۔",
      "ps": "تېزوالی یو یوناني کلمه ده چې Karl Pearson معرفي کړه. پدې معنا چې د فریکونسي ویش د ګراف د نورمال منحني په پرتله تېز یا چپټ والی."
    },
    {
      "id": "stat11-s143-k1",
      "en": "If curve of a distribution is like normal curve it is called meso-kurtic.",
      "ur": "اگر تقسیم کا منحنی نارمل منحنی جیسا ہو تو اسے میسو کرٹک کہتے ہیں۔",
      "ps": "که د ویش منحني د نورمال منحني په څېر وي نو دې ته میسو‌کرټیک ویل کېږي.",
      "listGroup": "kurt-types"
    },
    {
      "id": "stat11-s143-k2",
      "en": "If curve of a distribution is flatter than the normal curve, it is called platy-kurtic.",
      "ur": "اگر تقسیم کا منحنی نارمل منحنی سے زیادہ چپٹا ہو تو اسے پلیٹی کرٹک کہتے ہیں۔",
      "ps": "که د ویش منحني د نورمال منحني څخه ډېر چپټ وي نو دې ته پلېټي‌کرټیک ویل کېږي.",
      "listGroup": "kurt-types"
    },
    {
      "id": "stat11-s143-k3",
      "en": "If curve of a distribution is high peaked than the normal curve, it is called lepto-kurtic.",
      "ur": "اگر تقسیم کا منحنی نارمل منحنی سے زیادہ اونچی چوٹی والا ہو تو اسے لیپٹو کرٹک کہتے ہیں۔",
      "ps": "که د ویش منحني د نورمال منحني څخه ډېره لوړه څوکه ولري نو دې ته لېپټو‌کرټیک ویل کېږي.",
      "listGroup": "kurt-types"
    }
  ],
