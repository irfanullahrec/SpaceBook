5, 950], [144, 959]]}, {"text": "= 50,000", "conf": 0.8, "box": [[779, 924], [877, 924], [877, 951], [779, 951]]}, {"text": "6 is at the thousands place, its place value = 6 × 1,000", "conf": 0.934, "box": [[179, 990], [742, 983], [742, 1011], [179, 1019]]}, {"text": "= 6,000", "conf": 0.862, "box": [[780, 982], [867, 982], [867, 1013], [780, 1013]]}, {"text": "9 is at the hundreds place, its place value = 9 × 100", "conf": 0.926, "box": [[187, 1049], [723, 1044], [723, 1072], [187, 1076]]}, {"text": "= 900", "conf": 0.808, "box": [[778, 1044], [850, 1044], [850, 1072], [778, 1072]]}, {"text": "0 is at the tens place, its place value = 0 × 10", "conf": 0.909, "box": [[236, 1107], [710, 1105], [710, 1135], [237, 1137]]}, {"text": "= 00", "conf": 0.776, "box": [[778, 1106], [836, 1103], [837, 1133], [779, 1135]]}, {"text": "7 is at the ones place, its place value = 7 × 1", "conf": 0.911, "box": [[230, 1161], [695, 1162], [695, 1192], [229, 1191]]}, {"text": "= 7", "conf": 0.604, "box": [[775, 1165], [822, 1161], [824, 1188], [777, 1192]]}, {"text": "Give flash cards with place value written in numerals and words. Write a few numbers", "conf": 0.928, "box": [[173, 1252], [867, 1256], [866, 1279], [173, 1275]]}, {"text": "on the board and ask the students to write the place value of each digit.", "conf": 0.96, "box": [[171, 1274], [749, 1279], [749, 1302], [171, 1297]]}, {"text": "NOTFORSALE", "conf": 0.825, "box": [[37, 1353], [194, 1353], [194, 1377], [37, 1377]]}, {"text": "downloaded from awazeinqilab.com", "conf": 0.913, "box": [[179, 1473], [749, 1473], [749, 1509], [179, 1509]]}]}