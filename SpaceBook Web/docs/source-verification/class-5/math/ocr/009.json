{"file": "D:\\SpaceBook\\_cls5_jpg\\math\\009.jpg", "lines": [{"text": "1,456,907 = 1,000,000 + 400,000 + 50,000 + 6,000 + 900 + 00 + 7", "conf": 0.927, "box": [[189, 193], [839, 196], [839, 229], [189, 226]]}, {"text": "Writing a number as the sum of the place", "conf": 0.901, "box": [[239, 237], [645, 237], [645, 263], [239, 263]]}, {"text": "value of its digits is called expanded form.", "conf": 0.927, "box": [[239, 266], [651, 266], [651, 293], [239, 293]]}, {"text": "write the value and place value of each digit in 5,987,516.", "conf": 0.947, "box": [[194, 365], [771, 356], [772, 389], [194, 398]]}, {"text": "5 is at millions place, so its place value = 5 × 1,000,000= -5,000,000", "conf": 0.896, "box": [[179, 468], [854, 457], [855, 490], [179, 501]]}, {"text": "= 900,000", "conf": 0.858, "box": [[716, 506], [839, 506], [839, 533], [716, 533]]}, {"text": "9 is at hundred thousands place, so its place value = 9 × 100,000", "conf": 0.924, "box": [[80, 525], [698, 504], [699, 534], [81, 554]]}, {"text": "80,000", "conf": 0.784, "box": [[749, 557], [828, 555], [829, 583], [749, 585]]}, {"text": "downloaded from awazeinqilab.com", "conf": 0.926, "box": [[13, 568], [46, 568], [46, 1069], [13, 1069]]}, {"text": "8 is at ten thousands place, so its place value = 8 × 10,000", "conf": 0.925, "box": [[124, 572], [683, 558], [684, 584], [125, 598]]}, {"text": "7 is at thousands place, so its place value . = 7 × 1,000", "conf": 0.91, "box": [[157, 618], [672, 610], [673, 637], [158, 646]]}, {"text": "= 7,000", "conf": 0.864, "box": [[720, 609], [818, 605], [819, 635], [721, 639]]}, {"text": "5 is at hundreds place, so its place value = 5 × 100", "conf": 0.906, "box": [[166, 663], [656, 660], [656, 691], [166, 693]]}, {"text": "500", "conf": 0.699, "box": [[750, 659], [799, 656], [801, 686], [752, 689]]}, {"text": "1 is at tens place, so its place value = 1 × 10", "conf": 0.935, "box": [[209, 704], [646, 708], [646, 745], [209, 741]]}, {"text": "10", "conf": 0.664, "box": [[741, 713], [785, 713], [785, 740], [741, 740]]}, {"text": "6 is at ones place, so its place value = 6 × 1", "conf": 0.901, "box": [[206, 754], [633, 758], [633, 792], [206, 788]]}, {"text": "5,987,516 is read as \"five million, nine hundred and eighty-seven thousand,", "conf": 0.929, "box": [[79, 822], [830, 818], [830, 844], [79, 849]]}, {"text": "five hundred and sixteen\".", "conf": 0.922, "box": [[79, 850], [329, 847], [329, 871], [79, 873]]}, {"text": "9 + 01 + 009 + 000'2 + 000'08 + 000'006 +000'000'9 = 919286'9", "conf": 0.666, "box": [[133, 879], [803, 877], [803, 904], [133, 906]]}, {"text": "TryYourself", "conf": 0.883, "box": [[131, 924], [280, 921], [281, 952], [132, 955]]}, {"text": "K-2 is the 2nd highest mountain in the world. It", "conf": 0.91, "box": [[95, 975], [557, 977], [557, 1007], [95, 1005]]}, {"text": "is located on the Pakistan-China border. Its", "conf": 0.931, "box": [[96, 1005], [520, 1008], [520, 1036], [96, 1032]]}, {"text": "height is 861 100 centimetres.", "conf": 0.897, "box": [[98, 1035], [389, 1041], [388, 1065], [98, 1059]]}, {"text": "a) Write the height in expanded from.", "conf": 0.933, "box": [[96, 1062], [460, 1069], [460, 1096], [96, 1090]]}, {"text": "b) Write the place value of each digit:", "conf": 0.96, "box": [[96, 1090], [461, 1096], [461, 1126], [96, 1120]]}, {"text": "c) Write the height in words.", "conf": 0.898, "box": [[98, 1121], [370, 1127], [370, 1153], [98, 1147]]}, {"text": "Divide the students in groups. Ask them to make a 7-digit number and write", "conf": 0.948, "box": [[161, 1187], [807, 1192], [807, 1222], [161, 1216]]}, {"text": "the value and place value of each digit.", "conf": 0.94, "box": [[162, 1209], [494, 1215], [493, 1241], [161, 1235]]}, {"text": "NOTFORSALE", "conf": 0.847, "box": [[710, 1286], [861, 1286], [861, 1309], [710, 1309]]}, {"text": "downloaded from awazeingilab.com", "conf": 0.864, "box": [[179, 1472], [748, 1473], [748, 1509], [179, 1508]]}]}