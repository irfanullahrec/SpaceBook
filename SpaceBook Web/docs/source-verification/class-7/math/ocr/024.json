 298], [23, 298]]}, {"text": "First, compare the digits in the ones place. 0.29, 0.41", "conf": 0.913, "box": [[22, 299], [326, 299], [326, 318], [22, 318]]}, {"text": "They are the same. Now, compare the digits in tenths place.0.29, 0.41", "conf": 0.904, "box": [[22, 320], [423, 320], [423, 340], [22, 339]]}, {"text": "4 is greater than 2. So, 0.41 is greater than 0.29.", "conf": 0.874, "box": [[21, 345], [295, 346], [295, 365], [21, 364]]}, {"text": "Example 2:", "conf": 0.838, "box": [[21, 365], [91, 367], [91, 385], [21, 383]]}, {"text": "Tahirbought3packets ofdates thathavemasses of3.529kg.5.523kg and3.52kg", "conf": 0.921, "box": [[22, 384], [516, 387], [515, 408], [22, 404]]}, {"text": "respectively.Compare and arrange the masses of dates in ascending and descending order.", "conf": 0.904, "box": [[21, 406], [563, 409], [563, 428], [21, 425]]}, {"text": "Solution:", "conf": 0.851, "box": [[22, 426], [80, 426], [80, 443], [22, 443]]}, {"text": "The digits in the ones, tenths and hundredths places are the same.", "conf": 0.915, "box": [[21, 445], [415, 449], [415, 468], [21, 464]]}, {"text": "3.529, 3.523, 3.52", "conf": 0.88, "box": [[83, 466], [200, 468], [200, 485], [83, 484]]}, {"text": "So, we compare thedigits in thethousandths place.", "conf": 0.902, "box": [[21, 485], [327, 488], [327, 507], [21, 504]]}, {"text": "3.52 = 3.520", "conf": 0.795, "box": [[462, 483], [542, 483], [542, 503], [462, 503]]}, {"text": "3.529,3.523,3.520", "conf": 0.863, "box": [[80, 506], [203, 508], [202, 527], [79, 525]]}, {"text": "9 thousandths is greater than 3thousandths and 0 thousandths.", "conf": 0.899, "box": [[21, 529], [400, 533], [400, 552], [21, 548]]}, {"text": "So, 3.529 is the greatest.", "conf": 0.866, "box": [[20, 554], [168, 556], [168, 575], [20, 573]]}, {"text": "3 thousandths is greater than O thousandths.", "conf": 0.874, "box": [[19, 578], [292, 582], [292, 602], [19, 597]]}, {"text": "So, 3.520 is the smallest.", "conf": 0.933, "box": [[20, 605], [172, 605], [172, 624], [20, 624]]}, {"text": "Arranging number in ascending order,wecan write it as: 3.520, 3.523,3.529.", "conf": 0.902, "box": [[19, 629], [475, 635], [475, 654], [19, 648]]}, {"text": "Arranging number in descending order, we can write it as: 3.529,3.523,3.520.", "conf": 0.914, "box": [[19, 654], [484, 661], [484, 681], [19, 674]]}, {"text": "20", "conf": 0.665, "box": [[273, 746], [294, 746], [294, 763], [273, 763]]}, {"text": "NOTFORSALE", "conf": 0.882, "box": [[23, 760], [124, 760], [124, 779], [23, 779]]}]}