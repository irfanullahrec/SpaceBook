{"file": "D:\\SpaceBook\\_cls7_jpg\\drawing\\064.jpg", "lines": [{"text": "MAKINGSTENCILFROMAGIVENDESIGN", "conf": 0.921, "box": [[77, 49], [1015, 72], [1014, 124], [76, 101]]}, {"text": "Step 1. Tracing", "conf": 0.875, "box": [[80, 177], [416, 193], [413, 243], [77, 227]]}, {"text": "Trace the design neatlyon a tracingpaper.", "conf": 0.875, "box": [[80, 303], [880, 332], [878, 374], [79, 345]]}, {"text": "Step 2. Transferring", "conf": 0.89, "box": [[78, 426], [544, 438], [542, 491], [77, 480]]}, {"text": "Place the traced side of the tracing paper on a hard sheet. Stick it with a masking", "conf": 0.931, "box": [[77, 549], [1605, 585], [1604, 641], [76, 605]]}, {"text": "tape so that it does not move. Now draw over the lines of the design with a pencil", "conf": 0.908, "box": [[77, 618], [1606, 649], [1605, 698], [76, 667]]}, {"text": "or, preferably, an empty ballpoint. Apply enough pressure so that the design is", "conf": 0.928, "box": [[72, 682], [1610, 709], [1609, 771], [71, 744]]}, {"text": "transferred to the underneath hard sheet.", "conf": 0.918, "box": [[79, 751], [886, 771], [885, 814], [78, 794]]}, {"text": "Step 3. Cutting", "conf": 0.824, "box": [[79, 947], [437, 959], [435, 1010], [78, 998]]}, {"text": "Place the hard sheet on a glass slab if", "conf": 0.887, "box": [[79, 1075], [943, 1086], [943, 1136], [78, 1124]]}, {"text": ".com", "conf": 0.778, "box": [[930, 1099], [1058, 1035], [1079, 1077], [950, 1141]]}, {"text": "any suitable hard surface. Now carefully cut", "conf": 0.898, "box": [[78, 1214], [931, 1215], [931, 1261], [78, 1260]]}, {"text": "the design with a sharp cutter Try to keep it", "conf": 0.917, "box": [[76, 1272], [934, 1271], [934, 1328], [76, 1329]]}, {"text": "as neat as possible. Your stencil is ready.", "conf": 0.895, "box": [[79, 1347], [926, 1347], [926, 1390], [79, 1390]]}, {"text": "Stick it to any surface you want to print on", "conf": 0.896, "box": [[80, 1414], [931, 1411], [931, 1454], [80, 1457]]}, {"text": "and apply paint with a brush or spray.", "conf": 0.89, "box": [[80, 1479], [804, 1474], [804, 1523], [80, 1528]]}, {"text": "Activity3.1", "conf": 0.878, "box": [[321, 1721], [709, 1713], [710, 1783], [323, 1791]]}, {"text": "Make three different designs of 5x5 inches", "conf": 0.871, "box": [[126, 1937], [951, 1927], [951, 1969], [127, 1979]]}, {"text": "64", "conf": 0.666, "box": [[792, 2238], [856, 2238], [856, 2287], [792, 2287]]}, {"text": "MOTEORSAE", "conf": 0.594, "box": [[1226, 2273], [1620, 2263], [1621, 2294], [1226, 2303]]}, {"text": "ScannedwithCamScanner", "conf": 0.887, "box": [[1095, 2326], [1273, 2326], [1273, 2343], [1095, 2343]]}]}