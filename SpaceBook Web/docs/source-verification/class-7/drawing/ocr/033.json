{"file": "D:\\SpaceBook\\_cls7_jpg\\drawing\\033.jpg", "lines": [{"text": "Emphasis", "conf": 0.886, "box": [[111, 50], [325, 44], [326, 99], [112, 105]]}, {"text": "It means to emphasize certain area/areas of a", "conf": 0.898, "box": [[105, 169], [999, 156], [1000, 205], [106, 218]]}, {"text": "composition. It is the same as establishing a", "conf": 0.939, "box": [[103, 233], [1000, 224], [1001, 277], [104, 286]]}, {"text": "focal point or centre of interest. But emphasis", "conf": 0.899, "box": [[103, 301], [997, 291], [998, 342], [104, 351]]}, {"text": "has a different meaning too. An artist may", "conf": 0.916, "box": [[100, 363], [997, 361], [997, 414], [100, 416]]}, {"text": "sometimes emphasize an art element e.g.", "conf": 0.94, "box": [[100, 431], [993, 429], [993, 482], [100, 484]]}, {"text": "colour, shape, tonal contrast, texture, line, etc.", "conf": 0.926, "box": [[104, 507], [985, 498], [985, 541], [105, 550]]}, {"text": "Find out what element/s are emphasized in", "conf": 0.916, "box": [[103, 570], [987, 565], [987, 610], [103, 615]]}, {"text": "each of these three paintings?", "conf": 0.885, "box": [[104, 638], [657, 636], [658, 682], [104, 684]]}, {"text": "33", "conf": 0.666, "box": [[712, 2222], [775, 2222], [775, 2270], [712, 2270]]}, {"text": "ScannedwithCamScanner", "conf": 0.886, "box": [[1095, 2326], [1274, 2326], [1274, 2343], [1095, 2343]]}]}