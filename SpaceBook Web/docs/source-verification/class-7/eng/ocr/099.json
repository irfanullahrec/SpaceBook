{"file": "D:\\SpaceBook\\_cls7_jpg\\eng\\099.jpg", "lines": [{"text": "@Reading", "conf": 0.809, "box": [[42, 179], [270, 141], [280, 199], [52, 237]]}, {"text": "The BlackLand", "conf": 0.881, "box": [[639, 441], [897, 460], [894, 494], [637, 475]]}, {"text": "I will plough the land,", "conf": 0.933, "box": [[102, 508], [463, 481], [467, 527], [106, 554]]}, {"text": "Turning up the black soil.", "conf": 0.913, "box": [[103, 560], [523, 531], [527, 581], [107, 610]]}, {"text": "Even as a boat", "conf": 0.927, "box": [[102, 729], [342, 708], [345, 748], [106, 769]]}, {"text": "I have run a furrow", "conf": 0.919, "box": [[99, 837], [415, 814], [418, 854], [102, 877]]}, {"text": "Straight across the ridges.", "conf": 0.889, "box": [[99, 886], [529, 866], [531, 915], [101, 935]]}, {"text": "I will sow down this field,", "conf": 0.915, "box": [[97, 941], [517, 920], [519, 967], [99, 988]]}, {"text": "Scattering gems.", "conf": 0.901, "box": [[100, 1003], [375, 988], [378, 1025], [102, 1040]]}, {"text": "With both hands will I scatter", "conf": 0.867, "box": [[97, 1048], [593, 1034], [595, 1081], [98, 1095]]}, {"text": "As I tread the loam", "conf": 0.859, "box": [[97, 1164], [413, 1151], [414, 1191], [98, 1204]]}, {"text": "My feet sink deep.", "conf": 0.899, "box": [[96, 1219], [398, 1207], [399, 1250], [97, 1262]]}, {"text": "The black earth embraces my ankles", "conf": 0.916, "box": [[94, 1269], [710, 1262], [711, 1308], [95, 1315]]}, {"text": "And clings to my bent knees.", "conf": 0.889, "box": [[92, 1329], [589, 1319], [590, 1362], [93, 1372]]}, {"text": "I sing as I go Scattering emeralds.", "conf": 0.912, "box": [[94, 1385], [663, 1376], [664, 1418], [95, 1427]]}, {"text": "The wind sings upon my lips,", "conf": 0.913, "box": [[92, 1437], [584, 1434], [584, 1480], [92, 1483]]}, {"text": "And pearls stream off my neck and forehead", "conf": 0.896, "box": [[92, 1495], [850, 1491], [850, 1534], [92, 1539]]}, {"text": "I am bathed in a sweat of pearls", "conf": 0.889, "box": [[92, 1554], [637, 1550], [638, 1590], [92, 1594]]}, {"text": "Eyes straight forward", "conf": 0.919, "box": [[93, 1615], [452, 1607], [452, 1646], [94, 1654]]}, {"text": "Rest on a brightening ultimate slope.", "conf": 0.937, "box": [[89, 1668], [721, 1669], [721, 1709], [89, 1708]]}, {"text": "(By: Joseph Warren Beach)", "conf": 0.938, "box": [[756, 1727], [1219, 1729], [1219, 1769], [756, 1767]]}, {"text": "About the Poet:", "conf": 0.88, "box": [[31, 1834], [260, 1837], [259, 1871], [31, 1868]]}, {"text": "Joseph Warren Beach (January 14, 1880 - August 13, 1957) was an American poet, novelist, critic,", "conf": 0.925, "box": [[26, 1881], [1469, 1883], [1469, 1922], [26, 1920]]}, {"text": "educator and literary scholar. Beach was the author of a number of works of poetry, literary criticism,", "conf": 0.905, "box": [[26, 1926], [1469, 1928], [1469, 1968], [26, 1966]]}, {"text": "and fiction. He was one of the first academic scholars to work on literary figures and his quality work.", "conf": 0.936, "box": [[24, 1971], [1458, 1970], [1458, 2013], [24, 2014]]}, {"text": "94", "conf": 0.666, "box": [[748, 2118], [807, 2118], [807, 2161], [748, 2161]]}, {"text": "NOTFORSALE", "conf": 0.868, "box": [[109, 2156], [391, 2160], [391, 2197], [108, 2193]]}]}