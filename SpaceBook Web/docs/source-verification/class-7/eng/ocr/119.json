63, 1697], [929, 1685], [929, 1727], [64, 1740]]}, {"text": "phones became common. Rotary phones had dials that let", "conf": 0.909, "box": [[63, 1749], [987, 1731], [988, 1773], [64, 1791]]}, {"text": "users enter number combinations to contact other users.", "conf": 0.92, "box": [[61, 1801], [956, 1784], [956, 1820], [62, 1836]]}, {"text": "During the 1960s and 1970s, dials were largely replaced by", "conf": 0.939, "box": [[60, 1845], [983, 1832], [984, 1874], [61, 1887]]}, {"text": "the \"touch-tone\" keypads that remain standard today.", "conf": 0.939, "box": [[55, 1892], [916, 1881], [916, 1930], [56, 1941]]}, {"text": "1988", "conf": 0.72, "box": [[1234, 1942], [1308, 1940], [1309, 1972], [1235, 1975]]}, {"text": "Carphone", "conf": 0.877, "box": [[1219, 1981], [1321, 1978], [1322, 2004], [1220, 2008]]}, {"text": "114", "conf": 0.746, "box": [[706, 2065], [781, 2061], [784, 2102], [708, 2106]]}, {"text": "NOLFORSALE", "conf": 0.849, "box": [[119, 2108], [381, 2114], [380, 2146], [118, 2141]]}]}