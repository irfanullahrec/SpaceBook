], [487, 457], [385, 457]]}, {"text": "Khujista Akhtar", "conf": 0.878, "box": [[489, 441], [587, 439], [587, 455], [490, 457]]}, {"text": "Rafi'u-sh-shan", "conf": 0.847, "box": [[234, 442], [325, 442], [325, 459], [234, 459]]}, {"text": "Azimu-sh-Shan", "conf": 0.913, "box": [[98, 443], [192, 443], [192, 460], [98, 460]]}, {"text": "Muhayyiu-s-sana", "conf": 0.9, "box": [[667, 435], [778, 431], [779, 451], [668, 455]]}, {"text": "12.Muhammad Shah", "conf": 0.885, "box": [[490, 471], [618, 467], [618, 484], [491, 489]]}, {"text": "14.Alamgir lI", "conf": 0.703, "box": [[393, 472], [476, 472], [476, 489], [393, 489]]}, {"text": "Muhammod", "conf": 0.781, "box": [[319, 473], [374, 473], [374, 486], [319, 486]]}, {"text": "10.Raf ud-", "conf": 0.76, "box": [[255, 474], [306, 472], [306, 486], [256, 489]]}, {"text": "11.Shah", "conf": 0.809, "box": [[196, 476], [230, 476], [230, 487], [196, 487]]}, {"text": "Shah Jahan I", "conf": 0.781, "box": [[674, 469], [769, 464], [770, 484], [675, 489]]}, {"text": "9.Farrukhsiyar", "conf": 0.837, "box": [[72, 480], [161, 480], [161, 498], [72, 498]]}, {"text": "Jahan III", "conf": 0.754, "box": [[197, 485], [231, 485], [231, 497], [197, 497]]}, {"text": "Darajat", "conf": 0.85, "box": [[264, 485], [298, 485], [298, 497], [264, 497]]}, {"text": "Ibrohm", "conf": 0.768, "box": [[328, 484], [362, 484], [362, 495], [328, 495]]}, {"text": "(Roshan Akhtar)", "conf": 0.878, "box": [[510, 485], [600, 482], [600, 498], [511, 501]]}, {"text": "15. Shah Alam II", "conf": 0.874, "box": [[387, 500], [480, 500], [480, 517], [387, 517]]}, {"text": "(Ali Gauhar)", "conf": 0.874, "box": [[397, 515], [467, 515], [467, 529], [397, 529]]}, {"text": "13.Ahmad Shah", "conf": 0.835, "box": [[495, 511], [592, 507], [592, 525], [496, 528]]}, {"text": "(Bahadur)", "conf": 0.822, "box": [[515, 524], [574, 524], [574, 538], [515, 538]]}, {"text": "16.Akbar Shah II", "conf": 0.841, "box": [[384, 537], [484, 537], [484, 553], [384, 553]]}, {"text": "(Mirza Akbar)", "conf": 0.901, "box": [[391, 551], [471, 549], [472, 565], [391, 567]]}, {"text": "Bedor Bakht", "conf": 0.777, "box": [[495, 547], [580, 545], [580, 565], [496, 567]]}, {"text": "17.Bahadur Shah Zafar", "conf": 0.872, "box": [[365, 576], [507, 575], [507, 594], [365, 595]]}, {"text": "Reasons of the Collapse of the Mughal Empire", "conf": 0.895, "box": [[68, 618], [582, 612], [582, 641], [68, 647]]}, {"text": "There were many causes that led to collapse of the Mughal Empire. Most prominent ones", "conf": 0.932, "box": [[65, 656], [819, 644], [819, 671], [65, 684]]}, {"text": "arementionedbelow:", "conf": 0.928, "box": [[65, 683], [253, 683], [253, 703], [65, 703]]}, {"text": "Since there was no fixed rule of succession, the Mughal dynasty very often", "conf": 0.934, "box": [[119, 717], [817, 705], [817, 731], [120, 743]]}, {"text": "witnessed war between the princes after the death of aking.", "conf": 0.904, "box": [[120, 743], [627, 734], [627, 757], [121, 767]]}, {"text": "Later Mughals were mostly indulged in leisure which made them pay less attention", "conf": 0.923, "box": [[118, 779], [816, 765], [816, 792], [119, 805]]}, {"text": "towardsstateaffairs.", "conf": 0.925, "box": [[123, 807], [295, 807], [295, 824], [123, 824]]}, {"text": "Empire was very big and modes of communication were not that strong. It was", "conf": 0.94, "box": [[120, 840], [817, 827], [817, 854], [121, 868]]}, {"text": "extremely difficult for a central government to keep effective administration.", "conf": 0.924, "box": [[120, 867], [762, 850], [763, 877], [121, 893]]}, {"text": "Military weakness was another important cause of decline of the Mughals. After", "conf": 0.925, "box": [[119, 901], [814, 888], [814, 915], [120, 928]]}, {"text": "Aurangzeb, later Mughals did not pay much attention to the strengthening of the", "conf": 0.925, "box": [[119, 926], [814, 913], [814, 939], [120, 953]]}, {"text": "army and became dependent upon powerful nobles and other forces. No empire", "conf": 0.936, "box": [[116, 949], [815, 935], [815, 965], [117, 978]]}, {"text": "can stayunited intheabsenceofapowerful army.", "conf": 0.938, "box": [[118, 976], [538, 969], [538, 992], [119, 999]]}, {"text": "During this period of decline, many independent kingdoms emerged. Provinces like", "conf": 0.95, "box": [[63, 1017], [814, 1005], [814, 1030], [63, 1043]]}, {"text": "Bengal and Oudh were under such independent rulers who paid no respect to the central", "conf": 0.937, "box": [[63, 1040], [815, 1029], [815, 1057], [63, 1067]]}, {"text": "authority of the emperor. Marathas, Sikhs and Rohillas got power in different parts. These", "conf": 0.909, "box": [[62, 1064], [814, 1055], [814, 1082], [62, 1091]]}, {"text": "independent kingdoms made it easy for the British to defeat them one by one until", "conf": 0.938, "box": [[60, 1086], [816, 1078], [816, 1107], [60, 1115]]}, {"text": "theygot complete controlof India in1857.", "conf": 0.887, "box": [[62, 1116], [419, 1108], [420, 1131], [62, 1139]]}, {"text": "(97)", "conf": 0.625, "box": [[419, 1153], [448, 1153], [448, 1177], [419, 1177]]}]}