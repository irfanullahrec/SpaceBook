ox": [[65, 610], [482, 620], [481, 646], [65, 636]]}, {"text": "including most of south-eastern Europeto the", "conf": 0.914, "box": [[66, 636], [482, 647], [481, 671], [66, 659]]}, {"text": "gatesofVienna,present-dayHungary,the Balkan", "conf": 0.912, "box": [[66, 661], [482, 672], [481, 696], [66, 685]]}, {"text": "region,Greece,andpartsofUkraine;portionsof", "conf": 0.946, "box": [[65, 687], [483, 697], [482, 720], [65, 711]]}, {"text": "theMiddle East wherenowIraq, Syria, Palestine", "conf": 0.872, "box": [[65, 711], [483, 722], [482, 746], [65, 735]]}, {"text": "andEgyptare;NorthAfricaasfarwestas", "conf": 0.907, "box": [[66, 737], [484, 747], [483, 771], [66, 760]]}, {"text": "Algeria; and large parts of the Arabian Peninsula", "conf": 0.904, "box": [[66, 760], [484, 771], [483, 797], [66, 787]]}, {"text": "including Yemen and the Hejaz region.", "conf": 0.902, "box": [[66, 787], [400, 796], [399, 819], [66, 810]]}, {"text": "TheConquestof Constantinople", "conf": 0.885, "box": [[567, 813], [751, 815], [750, 835], [567, 833]]}, {"text": "The largest geographical expansions made by the Ottomans were during the reigns of", "conf": 0.91, "box": [[65, 824], [810, 837], [810, 867], [65, 853]]}, {"text": "Sultan Muhammad Fatih-the conqueror of Constantinople. Another was SelimI-who", "conf": 0.923, "box": [[66, 850], [810, 863], [810, 890], [66, 878]]}, {"text": "conquered Egypt and assumed thetitleof Caliph.Most important was SuleymanI-", "conf": 0.894, "box": [[67, 878], [809, 890], [809, 914], [67, 902]]}, {"text": "called as Suleyman the Magnificent by Europeans for remaining in power for 46 years", "conf": 0.922, "box": [[67, 902], [810, 914], [810, 941], [67, 928]]}, {"text": "and reaching with his armies until the gates of Vienna (Austria).This wave of Ottoman", "conf": 0.916, "box": [[67, 926], [811, 939], [811, 965], [67, 952]]}, {"text": "expansion is known as the Classical AgeoftheOttoman Empirebetweenthe Conquest", "conf": 0.902, "box": [[68, 953], [812, 965], [812, 989], [68, 978]]}, {"text": "of Constantinople in1453ADuntilthesecondhalfof thesixteenthcentury,roughlythe", "conf": 0.936, "box": [[68, 979], [811, 991], [811, 1014], [68, 1002]]}, {"text": "end of the reign of Suleiman the Magnificent in 1566 AD. During this period, the", "conf": 0.908, "box": [[68, 1003], [812, 1015], [812, 1041], [68, 1028]]}, {"text": "Ottoman Empiredeveloped the institutional foundations which it would keep, in various", "conf": 0.889, "box": [[68, 1027], [813, 1040], [813, 1066], [68, 1054]]}, {"text": "changes, for several centuries. The Ottoman Empire reached its most extensive", "conf": 0.91, "box": [[67, 1054], [814, 1065], [814, 1091], [67, 1080]]}, {"text": "boundaries in 1699AD.", "conf": 0.869, "box": [[69, 1080], [278, 1083], [278, 1106], [69, 1103]]}]}