{"file": "D:\\SpaceBook\\_cls7_jpg\\hist\\096.jpg", "lines": [{"text": "Unit:05", "conf": 0.863, "box": [[356, 84], [417, 84], [417, 101], [356, 101]]}, {"text": "TheMughal Empire", "conf": 0.83, "box": [[421, 83], [554, 83], [554, 100], [421, 100]]}, {"text": "Muslim-HinduinteractionsduringthereignofHumayun", "conf": 0.943, "box": [[265, 504], [598, 503], [598, 520], [265, 521]]}, {"text": "Contributions of Mughals in Art and Architecture", "conf": 0.883, "box": [[62, 552], [495, 552], [495, 575], [62, 575]]}, {"text": "Apart from religious and social enlightenment of the Indian Society,the Mughal dynasty", "conf": 0.931, "box": [[61, 582], [835, 578], [835, 602], [61, 606]]}, {"text": "widely displayed remarkable art forms and mixed Islamic and Indian architectural styles.", "conf": 0.925, "box": [[60, 608], [832, 604], [832, 627], [60, 631]]}, {"text": "Mughal architecture started to flourish from the reign of Akbar until the early 18th", "conf": 0.918, "box": [[60, 634], [834, 629], [834, 652], [60, 657]]}, {"text": "century. Some examples of the Mughal art and architecture can be found in Pakistan,", "conf": 0.911, "box": [[59, 660], [833, 655], [833, 678], [59, 684]]}, {"text": "Afghanistan,India, Nepaland Bangladesh.", "conf": 0.886, "box": [[60, 686], [423, 685], [423, 708], [60, 709]]}, {"text": "aWd", "conf": 0.54, "box": [[157, 753], [267, 693], [290, 735], [179, 795]]}, {"text": "HumayunsTombinDelhi", "conf": 0.868, "box": [[361, 1130], [517, 1126], [517, 1146], [361, 1149]]}]}