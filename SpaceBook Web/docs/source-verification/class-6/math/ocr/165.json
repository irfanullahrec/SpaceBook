8, 1107]]}, {"text": "672", "conf": 0.64, "box": [[836, 1121], [900, 1119], [902, 1158], [837, 1160]]}, {"text": "56", "conf": 0.51, "box": [[845, 1168], [895, 1168], [895, 1208], [845, 1208]]}, {"text": "12 = W", "conf": 0.684, "box": [[833, 1225], [943, 1225], [943, 1260], [833, 1260]]}, {"text": "So, the width of the chocolate box is 12 cm.", "conf": 0.892, "box": [[206, 1297], [899, 1280], [899, 1316], [207, 1333]]}, {"text": "Exercise8.6", "conf": 0.912, "box": [[870, 1398], [1101, 1394], [1102, 1435], [871, 1439]]}, {"text": "A cuboid glass box has dimensions 3 m × 2 m × 1 m. Find the volume", "conf": 0.933, "box": [[293, 1532], [1470, 1510], [1471, 1552], [294, 1574]]}, {"text": "of water that it can hold.", "conf": 0.879, "box": [[299, 1585], [728, 1573], [729, 1607], [300, 1619]]}, {"text": "A box of cereal is 22 cm high, 12 cm long and 6 cm wide. What is the", "conf": 0.937, "box": [[294, 1635], [1478, 1616], [1479, 1662], [295, 1681]]}, {"text": "capacity of the cereal box?", "conf": 0.91, "box": [[300, 1691], [765, 1673], [766, 1715], [302, 1733]]}, {"text": "A cube shaped container has a length of 72 cm. If it is filled with blocks", "conf": 0.935, "box": [[298, 1738], [1525, 1720], [1526, 1769], [299, 1787]]}, {"text": "up to a height of 42 cm, find the remaining capacity of the container.", "conf": 0.935, "box": [[299, 1785], [1493, 1766], [1494, 1825], [300, 1844]]}, {"text": "A Masjid is 22 m long, 12 m wide and 18 m high. Find the cost of", "conf": 0.91, "box": [[303, 1846], [1422, 1833], [1423, 1886], [303, 1899]]}, {"text": "Find the cost of painting a cuboid container of length 4 m, width 3.5 m", "conf": 0.917, "box": [[308, 1963], [1532, 1956], [1533, 2012], [308, 2020]]}, {"text": "163", "conf": 0.501, "box": [[933, 2141], [999, 2141], [999, 2179], [933, 2179]]}, {"text": "NOTFORSALE", "conf": 0.879, "box": [[339, 2152], [630, 2137], [632, 2173], [341, 2188]]}]}