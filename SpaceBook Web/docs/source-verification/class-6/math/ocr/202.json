{"file": "D:\\SpaceBook\\Books\\6th\\Math\\JPG\\202.jpg", "lines": [{"text": "Step IV: Using a ruler draw a ray OG passing", "conf": 0.897, "box": [[105, 152], [819, 148], [819, 191], [105, 195]]}, {"text": "through the point R. So, ZAOG= 105°", "conf": 0.902, "box": [[103, 216], [702, 209], [703, 249], [104, 256]]}, {"text": "105°", "conf": 0.781, "box": [[1240, 338], [1324, 338], [1324, 381], [1240, 381]]}, {"text": "Example 7:", "conf": 0.84, "box": [[74, 462], [283, 464], [282, 505], [74, 503]]}, {"text": "Let's draw ZABC = 120°.", "conf": 0.867, "box": [[90, 521], [479, 523], [479, 560], [90, 558]]}, {"text": "Solution:", "conf": 0.897, "box": [[89, 581], [242, 581], [242, 615], [89, 615]]}, {"text": "Steps of Construction:", "conf": 0.919, "box": [[87, 636], [456, 638], [456, 672], [87, 670]]}, {"text": "Step I: Draw a ray BC using a ruler.", "conf": 0.906, "box": [[81, 697], [649, 702], [648, 748], [81, 744]]}, {"text": "Step II: Place the pointer of the compass at point B and", "conf": 0.939, "box": [[78, 831], [991, 839], [991, 879], [78, 872]]}, {"text": "draw an arc of suitable radius that will cut the ray BC at", "conf": 0.932, "box": [[75, 885], [964, 893], [964, 936], [75, 928]]}, {"text": "any point Q.", "conf": 0.845, "box": [[76, 944], [267, 944], [267, 981], [76, 981]]}, {"text": "Step IlI: With the same opening of the compass, place", "conf": 0.932, "box": [[68, 1099], [968, 1120], [967, 1163], [67, 1142]]}, {"text": "the pointer of the compass at point Q and draw an arc", "conf": 0.909, "box": [[67, 1156], [949, 1178], [948, 1218], [66, 1196]]}, {"text": "that will cut the previous arc at point R.", "conf": 0.911, "box": [[58, 1212], [691, 1229], [690, 1269], [57, 1251]]}, {"text": "Step IV: With the same opening of the compass, place", "conf": 0.925, "box": [[57, 1399], [957, 1428], [955, 1471], [56, 1442]]}, {"text": "the pointer of the compass at point R and draw an arc that", "conf": 0.929, "box": [[56, 1459], [1014, 1488], [1012, 1531], [55, 1502]]}, {"text": "will cut the initial arc at point P.", "conf": 0.926, "box": [[56, 1516], [558, 1536], [556, 1573], [55, 1553]]}, {"text": "Step V: Using a ruler draw a ray BA passing through the", "conf": 0.942, "box": [[43, 1743], [972, 1771], [970, 1824], [42, 1796]]}, {"text": "point P. So, the ZABC = 120°", "conf": 0.881, "box": [[47, 1810], [521, 1826], [519, 1863], [46, 1848]]}, {"text": "120°", "conf": 0.746, "box": [[1139, 1874], [1220, 1874], [1220, 1914], [1139, 1914]]}, {"text": "200", "conf": 0.749, "box": [[718, 2059], [792, 2062], [791, 2102], [716, 2099]]}, {"text": "NOTFORSALE", "conf": 0.829, "box": [[1108, 2079], [1419, 2095], [1417, 2128], [1106, 2112]]}]}