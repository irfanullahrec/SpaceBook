1]]}, {"text": "Example 1:", "conf": 0.861, "box": [[182, 886], [377, 889], [376, 931], [181, 927]]}, {"text": "In a bus,there are 20 men and 14 women. Find the ratio of men to women in its simplest", "conf": 0.872, "box": [[180, 942], [1581, 961], [1580, 998], [179, 980]]}, {"text": "form.", "conf": 0.809, "box": [[178, 1000], [274, 1000], [274, 1039], [178, 1039]]}, {"text": "Solution:", "conf": 0.891, "box": [[180, 1057], [344, 1061], [343, 1098], [179, 1094]]}, {"text": "Numberofmen", "conf": 0.887, "box": [[351, 1124], [607, 1124], [607, 1157], [351, 1157]]}, {"text": "to", "conf": 0.655, "box": [[876, 1129], [915, 1129], [915, 1163], [876, 1163]]}, {"text": "Numberofwomen", "conf": 0.914, "box": [[1156, 1131], [1459, 1135], [1458, 1172], [1156, 1168]]}, {"text": "20", "conf": 0.571, "box": [[456, 1178], [506, 1178], [506, 1221], [456, 1221]]}, {"text": "14", "conf": 0.658, "box": [[1283, 1190], [1334, 1190], [1334, 1232], [1283, 1232]]}, {"text": "So, we can say that the number of men and women in the bus are in the ratio of 20 : 14.", "conf": 0.941, "box": [[179, 1253], [1583, 1263], [1583, 1306], [178, 1296]]}, {"text": "Wecanalsowriteitasfraction.", "conf": 0.915, "box": [[185, 1329], [684, 1329], [684, 1360], [185, 1360]]}, {"text": "Number ofmen", "conf": 0.832, "box": [[321, 1393], [581, 1393], [581, 1429], [321, 1429]]}, {"text": "Numberofwomen", "conf": 0.851, "box": [[298, 1451], [606, 1451], [606, 1484], [298, 1484]]}, {"text": "14", "conf": 0.528, "box": [[687, 1451], [735, 1451], [735, 1488], [687, 1488]]}, {"text": "For finding the simplest form we divide the antecedent (20) and consequent (14) by", "conf": 0.942, "box": [[180, 1517], [1510, 1528], [1509, 1584], [179, 1573]]}, {"text": "theircommonfactorthat is2, weget.", "conf": 0.929, "box": [[185, 1587], [790, 1583], [790, 1619], [186, 1624]]}, {"text": "20", "conf": 0.667, "box": [[452, 1662], [504, 1662], [504, 1703], [452, 1703]]}, {"text": "20 - 2", "conf": 0.704, "box": [[560, 1663], [672, 1663], [672, 1701], [560, 1701]]}, {"text": "10", "conf": 0.516, "box": [[727, 1661], [777, 1661], [777, 1701], [727, 1701]]}, {"text": "QuickCheck", "conf": 0.901, "box": [[1021, 1663], [1207, 1669], [1206, 1702], [1020, 1697]]}, {"text": "14", "conf": 0.515, "box": [[454, 1717], [505, 1717], [505, 1758], [454, 1758]]}, {"text": "14 +7", "conf": 0.74, "box": [[560, 1718], [669, 1716], [670, 1754], [561, 1757]]}, {"text": "Can you tell the ratio of the number", "conf": 0.891, "box": [[1021, 1729], [1490, 1737], [1489, 1775], [1020, 1766]]}, {"text": "So, 20 : 14 = 10 : 7.", "conf": 0.829, "box": [[188, 1773], [501, 1765], [501, 1801], [189, 1809]]}, {"text": "of women to the number of men?", "conf": 0.913, "box": [[1021, 1766], [1462, 1777], [1461, 1814], [1020, 1803]]}, {"text": "83", "conf": 0.623, "box": [[884, 2022], [934, 2022], [934, 2057], [884, 2057]]}, {"text": "NOTFORSALE", "conf": 0.841, "box": [[282, 2036], [575, 2020], [577, 2053], [284, 2069]]}]}