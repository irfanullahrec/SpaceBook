 858]]}, {"text": "theparkattherateof Rs320permetresquare?", "conf": 0.926, "box": [[247, 879], [1002, 876], [1002, 916], [247, 919]]}, {"text": "Sehrish wants to distribute Rs 1000 among needy children on Eid. For this purpose, she needs", "conf": 0.942, "box": [[236, 941], [1749, 930], [1749, 975], [236, 985]]}, {"text": "change of Rs 1000 in smaller denominations. In how many ways can she get the change in", "conf": 0.918, "box": [[236, 1003], [1691, 996], [1691, 1042], [236, 1049]]}, {"text": "smaller denominations?", "conf": 0.891, "box": [[234, 1070], [607, 1068], [607, 1104], [234, 1106]]}, {"text": "Hamza is thinkingofa numberbetween1to100.Usethegivencluesto", "conf": 0.915, "box": [[232, 1131], [1385, 1131], [1385, 1170], [232, 1170]]}, {"text": "find the number.", "conf": 0.825, "box": [[231, 1195], [490, 1197], [490, 1231], [231, 1229]]}, {"text": "Thenumber is greater than 10.", "conf": 0.846, "box": [[279, 1257], [763, 1260], [763, 1300], [279, 1296]]}, {"text": "Hint", "conf": 0.634, "box": [[1302, 1285], [1394, 1289], [1392, 1328], [1301, 1324]]}, {"text": "The numberis not a multiple of 4.", "conf": 0.856, "box": [[278, 1320], [810, 1326], [810, 1363], [278, 1357]]}, {"text": "Usethehundredschart", "conf": 0.892, "box": [[1148, 1336], [1550, 1340], [1550, 1373], [1148, 1369]]}, {"text": "The number is not a multiple of 8 as well.", "conf": 0.87, "box": [[275, 1384], [928, 1391], [928, 1428], [275, 1421]]}, {"text": "to help you.", "conf": 0.837, "box": [[1242, 1382], [1450, 1387], [1449, 1428], [1241, 1422]]}, {"text": "6 is thefactor of this number.", "conf": 0.802, "box": [[274, 1445], [739, 1454], [739, 1490], [274, 1481]]}, {"text": "The number is a multiple of 9.", "conf": 0.861, "box": [[273, 1509], [743, 1517], [743, 1556], [273, 1548]]}, {"text": "The numberis even.", "conf": 0.88, "box": [[274, 1575], [590, 1580], [590, 1616], [274, 1610]]}, {"text": "Its ones digit is greater than its tens digit", "conf": 0.89, "box": [[271, 1639], [925, 16