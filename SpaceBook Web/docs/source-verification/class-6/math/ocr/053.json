], [261, 1596]]}, {"text": "Positive × Negative = Negative", "conf": 0.864, "box": [[1190, 1575], [1595, 1561], [1596, 1604], [1192, 1618]]}, {"text": "i.e. (-4) + (-4)) = (-4) × 2 = -8", "conf": 0.848, "box": [[260, 1612], [741, 1597], [742, 1633], [261, 1647]]}, {"text": "(-) × (+)", "conf": 0.849, "box": [[1249, 1619], [1388, 1617], [1388, 1655], [1249, 1657]]}, {"text": "Vle can show (-4) × 2 = -8 on the number line.", "conf": 0.919, "box": [[263, 1656], [997, 1642], [998, 1685], [264, 1699]]}, {"text": "So, the required integer is -8.", "conf": 0.892, "box": [[271, 1768], [735, 1750], [736, 1787], [273, 1805]]}, {"text": "9 (8 -7 -6 -5 4 -3 -2 -1 0", "conf": 0.79, "box": [[496, 1906], [1011, 1901], [1011, 1941], [496, 1945]]}, {"text": "10", "conf": 0.666, "box": [[1535, 1901], [1581, 1898], [1583, 1933], [1537, 1936]]}, {"text": "-10-9", "conf": 0.744, "box": [[397, 1918], [514, 1911], [516, 1943], [399, 1950]]}, {"text": "51", "conf": 0.665, "box": [[958, 2018], [1004, 2018], [1004, 2054], [958, 2054]]}, {"text": "NOTFORISALE", "conf": 0.852, "box": [[371, 2029], [654, 2013], [656, 2050], [373, 2066]]}]}