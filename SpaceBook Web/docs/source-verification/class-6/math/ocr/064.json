{"file": "D:\\SpaceBook\\Books\\6th\\Math\\JPG\\064.jpg", "lines": [{"text": ")(号×碧-*号", "conf": 0.616, "box": [[1082, 111], [1501, 116], [1500, 210], [1081, 205]]}, {"text": "h)-{-(5×2", "conf": 0.751, "box": [[135, 136], [579, 142], [578, 209], [134, 202]]}, {"text": "I) 22.46 × 3 + 2(7.82 - 2.42) + 9.5 × 3.4", "conf": 0.841, "box": [[606, 242], [1243, 232], [1244, 275], [607, 284]]}, {"text": "m)12.35 + [5.25 + 3(18.43 - 3.66 × 5.75)]", "conf": 0.899, "box": [[138, 321], [765, 326], [765, 363], [137, 358]]}, {"text": "3.8 Real-lifeProblems involving Simplification", "conf": 0.904, "box": [[273, 441], [1332, 441], [1332, 487], [273, 487]]}, {"text": "On every Sunday ljaz goes to the Sunday Bazaar for groceries, Here is the grocery list.", "conf": 0.893, "box": [[76, 511], [1549, 515], [1549, 560], [76, 556]]}, {"text": "Grocery list", "conf": 0.839, "box": [[260, 591], [484, 594], [484, 638], [259, 635]]}, {"text": "Price list", "conf": 0.863, "box": [[1018, 596], [1217, 596], [1217, 637], [1018, 637]]}, {"text": "Sugar", "conf": 0.831, "box": [[190, 645], [288, 649], [286, 691], [188, 687]]}, {"text": "5.5 kg", "conf": 0.795, "box": [[396, 644], [500, 652], [496, 695], [393, 687]]}, {"text": "Sugar", "conf": 0.718, "box": [[840, 649], [945, 653], [943, 700], [838, 696]]}, {"text": "Rs 76 per kg", "conf": 0.873, "box": [[1066, 649], [1278, 655], [1277, 699], [1065, 693]]}, {"text": "Flour", "conf": 0.749, "box": [[191, 705], [277, 709], [275, 748], [189, 744]]}, {"text": "8.3 kg", "conf": 0.814, "box": [[397, 705], [498, 712], [495, 755], [394, 748]]}, {"text": "Flour", "conf": 0.825, "box": [[841, 712], [933, 716], [931, 755], [839, 751]]}, {"text": "Rs 76 per kg", "conf": 0.789, "box": [[1067, 714], [1278, 721], [1277, 761], [1066, 755]]}, {"text": "Milk", "conf": 0.789, "box": [[190, 766], [266, 766], [266, 806], [190, 806]]}, {"text": "4 bottles", "conf": 0.894, "box": [[399, 770], [540, 773], [539, 810], [398, 806]]}, {"text": "Milk", "conf": 0.731, "box": [[841, 773], [920, 776], [918, 817], [840, 814]]}, {"text": "Rs 145.75 per bottle", "conf": 0.854, "box": [[1068, 780], [1410, 784], [1410, 824], [1067, 819]]}, {"text": "Meat", "conf": 0.73, "box": [[192, 825], [280, 829], [278, 867], [190, 863]]}, {"text": "3.23 kg", "conf": 0.843, "box": [[399, 826], [518, 834], [515, 876], [396, 867]]}, {"text": "Meat", "conf": 0.799, "box": [[842, 839], [934, 842], [933, 877], [841, 875]]}, {"text": "Rs 567 per kg", "conf": 0.908, "box": [[1067, 838], [1299, 846], [1297, 890], [1065, 882]]}, {"text": "Tomato", "conf": 0.814, "box": [[191, 886], [313, 891], [312, 927], [190, 922]]}, {"text": "2.75 kg", "conf": 0.806, "box": [[399, 885], [519, 895], [516, 937], [396, 927]]}, {"text": "Tomato", "conf": 0.854, "box": [[842, 900], [972, 904], [970, 942], [841, 937]]}, {"text": "Rs 30 per kg", "conf": 0.907, "box": [[1067, 899], [1280, 908], [1278, 952], [1065, 943]]}, {"text": "Example 1:", "conf": 0.899, "box": [[82, 970], [261, 976], [260, 1017], [81, 1011]]}, {"text": "a) If ljaz had a Rs 5000 currency note to pay the bill, how much amount will be left?", "conf": 0.928, "box": [[82, 1024], [1403, 1060], [1402, 1102], [81, 1066]]}, {"text": "b) Find the total bill of the shopping.", "conf": 0.924, "box": [[81, 1073], [644, 1096], [642, 1139], [80, 1116]]}, {"text": "c) Write in the single expression for ljaz's shopping.", "conf": 0.941, "box": [[83, 1129], [873, 1160], [871, 1199], [82, 1169]]}, {"text": "Solution:", "conf": 0.829, "box": [[83, 1178], [230, 1184], [229, 1218], [82, 1212]]}, {"text": "Cost of 1 kg sugar = Rs 76", "conf": 0.894, "box": [[83, 1228], [487, 1243], [485, 1282], [82, 1267]]}, {"text": "Cost of 5.5 kg sugar = Rs 76 × 5.5 = Rs 418", "conf": 0.88, "box": [[668, 1250], [1373, 1277], [1371, 1317], [666, 1290]]}, {"text": "Cost of 1 kg flour = Rs 76", "conf": 0.872, "box": [[86, 1282], [476, 1296], [474, 1335], [85, 1321]]}, {"text": "Costof8.3kgflour=Rs76×8.3=Rs630.8", "conf": 0.93, "box": [[669, 1305], [1374, 1336], [1372, 1372], [667, 1342]]}, {"text": "Costof1bottleofmilk=Rs145.75", "conf": 0.936, "box": [[88, 1336], [627, 1358], [625, 1392], [87, 1369]]}, {"text": "Costof4bottlesofmilk=Rs145.75x4=Rs583", "conf": 0.903, "box": [[660, 1360], [1471, 1398], [1469, 1431], [658, 1393]]}, {"text": "Cost of 1 kg meat = Rs 567", "conf": 0.866, "box": [[88, 1390], [500, 1407], [498, 1444], [87, 1427]]}, {"text": "Cost of 3.23 kg meat = Rs 567 × 3.23 = Rs 1831.41", "conf": 0.883, "box": [[659, 1414], [1482, 1454], [1480, 1491], [657, 1451]]}, {"text": "Cost of 1 kg tomato = Rs 30", "conf": 0.91, "box": [[88, 1443], [518, 1461], [516, 1499], [87, 1482]]}, {"text": "Cost of 2.75 kg tomato = Rs 30 × 2.75= Rs 82.5", "conf": 0.893, "box": [[657, 1468], [1426, 1507], [1424, 1545], [655, 1506]]}, {"text": "a) The total bill = Rs (418 + 630.8 + 583 + 1831.41 + 82.5) = Rs 3545.71", "conf": 0.916, "box": [[91, 1498], [1205, 1552], [1203, 1592], [89, 1538]]}, {"text": "b) Remaining = Rs 5000  Rs 3545.71 = Rs 1454.29", "conf": 0.904, "box": [[93, 1569], [877, 1604], [875, 1646], [91, 1611]]}, {"text": "So, the amount remaining is Rs 1454.29.", "conf": 0.905, "box": [[92, 1638], [700, 1666], [698, 1705], [91, 1677]]}, {"text": "c) Expression for ljaz's shopping", "conf": 0.916, "box": [[96, 1708], [575, 1732], [573, 1772], [94, 1748]]}, {"text": "or indirect, in real- life. Give some example from real- life, We can also use simplification for the", "conf": 0.938, "box": [[217, 1842], [1489, 1924], [1486, 1969], [214, 1886]]}, {"text": "calculation of bills.", "conf": 0.899, "box": [[221, 1886], [453, 1897], [451, 1927], [220, 1916]]}, {"text": "62", "conf": 0.665, "box": [[757, 2009], [806, 2009], [806, 2045], [757, 2045]]}, {"text": "NOTFORISALE", "conf": 0.855, "box": [[1124, 2039], [1436, 2060], [1434, 2093], [1122, 2072]]}]}