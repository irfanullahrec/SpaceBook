{"file": "D:\\SpaceBook\\Books\\6th\\Math\\JPG\\152.jpg", "lines": [{"text": "8.3.2AreaofParallelogram", "conf": 0.88, "box": [[149, 82], [687, 67], [688, 104], [150, 120]]}, {"text": "A four-sided figure whose opposite sides are parallel is called a parallelogram.", "conf": 0.922, "box": [[140, 134], [1429, 102], [1431, 155], [141, 187]]}, {"text": "Altitude", "conf": 0.84, "box": [[782, 379], [898, 376], [898, 410], [782, 413]]}, {"text": "base", "conf": 0.799, "box": [[854, 478], [926, 478], [926, 510], [854, 510]]}, {"text": "We can find the area of the parallelogram if we have its base and altitude.", "conf": 0.911, "box": [[134, 581], [1357, 567], [1357, 606], [135, 620]]}, {"text": "The formula to find the area of the parallelogram is:", "conf": 0.914, "box": [[136, 637], [971, 633], [971, 672], [136, 676]]}, {"text": "Area of Parallelogram = base × altitude", "conf": 0.881, "box": [[178, 696], [811, 691], [811, 727], [179, 733]]}, {"text": "Example 1:", "conf": 0.884, "box": [[129, 774], [318, 770], [319, 812], [130, 815]]}, {"text": "Find the area of theshaded path of parallelogram.", "conf": 0.862, "box": [[129, 830], [940, 834], [940, 870], [129, 866]]}, {"text": "18 cm", "conf": 0.609, "box": [[548, 1017], [636, 1022], [634, 1053], [546, 1048]]}, {"text": "16 cm", "conf": 0.665, "box": [[786, 1033], [875, 1036], [874, 1071], [785, 1068]]}, {"text": "30cm", "conf": 0.798, "box": [[886, 1119], [978, 1125], [976, 1157], [883, 1150]]}, {"text": "Solution:", "conf": 0.863, "box": [[124, 1135], [279, 1138], [278, 1172], [123, 1169]]}, {"text": "32 cm", "conf": 0.727, "box": [[885, 1169], [977, 1173], [975, 1203], [884, 1198]]}, {"text": "Altitude = a, = 18 cm", "conf": 0.87, "box": [[123, 1192], [463, 1199], [463, 1235], [122, 1228]]}, {"text": "Base = b, = 32 cm", "conf": 0.855, "box": [[123, 1250], [414, 1259], [413, 1296], [122, 1287]]}, {"text": "Area of outer parallelogram = b, × a,", "conf": 0.927, "box": [[122, 1307], [713, 1325], [712, 1365], [121, 1347]]}, {"text": "= 32 cm × 18 cm", "conf": 0.839, "box": [[563, 1380], [835, 1387], [834, 1420], [562, 1414]]}, {"text": "= 576 cm²", "conf": 0.739, "box": [[560, 1437], [729, 1440], [728, 1480], [559, 1477]]}, {"text": "Altitude = a, = 16 cm", "conf": 0.904, "box": [[120, 1494], [459, 1503], [458, 1544], [119, 1534]]}, {"text": "Base = b, = 30 cm", "conf": 0.844, "box": [[119, 1555], [411, 1566], [410, 1603], [118, 1592]]}, {"text": "Area of inner parallelogram = b, × az", "conf": 0.934, "box": [[118, 1613], [705, 1633], [704, 1675], [117, 1655]]}, {"text": "=30cm×16cm", "conf": 0.85, "box": [[557, 1688], [828, 1697], [827, 1731], [556, 1723]]}, {"text": "= 480 cm²", "conf": 0.821, "box": [[555, 1747], [723, 1750], [722, 1788], [554, 1785]]}, {"text": "Area of the shaded path of parallelogram = 576.cm*- 480 cm²", "conf": 0.892, "box": [[112, 1792], [1121, 1819], [1120, 1868], [111, 1841]]}, {"text": "= 96 cm²", "conf": 0.77, "box": [[780, 1865], [934, 1869], [934, 1910], [780, 1906]]}, {"text": "148", "conf": 0.748, "box": [[789, 1952], [857, 1955], [856, 1993], [787, 1990]]}, {"text": "NOTFORSALE", "conf": 0.791, "box": [[1178, 1965], [1488, 1982], [1486, 2015], [1176, 1998]]}]}