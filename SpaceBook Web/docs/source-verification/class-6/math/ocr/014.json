63, "box": [[464, 1536], [986, 1561], [984, 1604], [462, 1579]]}, {"text": "Productof non-common", "conf": 0.875, "box": [[1238, 1568], [1763, 1593], [1761, 1632], [1236, 1606]]}, {"text": "factorsof2ormorenumbers", "conf": 0.926, "box": [[436, 1598], [1011, 1621], [1010, 1657], [435, 1633]]}, {"text": "primefactors", "conf": 0.838, "box": [[1354, 1631], [1639, 1639], [1638, 1679], [1353, 1670]]}, {"text": "LCM=2x2x3", "conf": 0.759, "box": [[140, 1695], [423, 1705], [422, 1741], [139, 1731]]}, {"text": "LCM=4x3=12.", "conf": 0.75, "box": [[136, 1765], [458, 1778], [456, 1817], [134, 1805]]}, {"text": "So,theLCMof4and12is12.", "conf": 0.869, "box": [[135, 1844], [669, 1866], [667, 1906], [133, 1884]]}, {"text": "So, Asim and Amir will next visit the library together after 12 days.", "conf": 0.918, "box": [[128, 1927], [1353, 1991], [1350, 2043], [125, 1978]]}, {"text": "Put different numbers on the table. Make groups of the students and ask each group to pick 2 or 3", "conf": 0.933, "box": [[243, 2021], [1830, 2116], [1827, 2168], [240, 2073]]}, {"text": "numbers and find the LCM. Then share their answer with the other groups to check if they have", "conf": 0.924, "box": [[242, 2069], [1768, 2161], [1765, 2213], [239, 2121]]}, {"text": "doneit correctly", "conf": 0.811, "box": [[246, 2126], [498, 2142], [495, 2179], [243, 2163]]}, {"text": "12", "conf": 0.504, "box": [[866, 2300], [922, 2300], [922, 2345], [866, 2345]]}, {"text": "NOUFURSALE", "conf": 0.804, "box": [[1306, 2331], [1678, 2358], [1675, 2397], [1303, 2369]]}]}