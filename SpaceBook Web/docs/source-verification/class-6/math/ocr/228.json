xt": "ii. 8, 8, 9, 10, 11, 11, 13", "conf": 0.932, "box": [[54, 1794], [411, 1814], [408, 1857], [51, 1837]]}, {"text": "Share the following online quiz link of finding mean, median and mode.", "conf": 0.926, "box": [[181, 1907], [1139, 1933], [1138, 1976], [180, 1950]]}, {"text": "226", "conf": 0.748, "box": [[735, 2096], [809, 2099], [808, 2139], [733, 2136]]}, {"text": "NOTFORSALE", "conf": 0.859, "box": [[1127, 2106], [1436, 2121], [1434, 2157], [1125, 2142]]}]}