[[1424, 732], [1497, 741], [1492, 777], [1419, 768]]}, {"text": "e) (6 - x) + 2x = 8 f) 48 - x = 7x", "conf": 0.837, "box": [[339, 753], [870, 747], [870, 784], [339, 790]]}, {"text": "g) 4x - 8 = 2x", "conf": 0.845, "box": [[981, 745], [1209, 732], [1212, 772], [983, 785]]}, {"text": "7.4Solving Linear Equations", "conf": 0.886, "box": [[612, 844], [1253, 834], [1254, 881], [613, 890]]}, {"text": "Hamza has two erasers.His sister has 3", "conf": 0.896, "box": [[180, 942], [845, 941], [845, 978], [180, 979]]}, {"text": "erasers.There are 5 erasers altogether.", "conf": 0.897, "box": [[179, 1001], [838, 1000], [838, 1036], [179, 1037]]}, {"text": "this equation using the weighing scale.", "conf": 0.92, "box": [[176, 1113], [803, 1112], [803, 1153], [176, 1154]]}, {"text": "We can see that the expressions on both sides", "conf": 0.878, "box": [[175, 1170], [920, 1168], [920, 1208], [175, 1210]]}, {"text": "of the equation are equal. Let's add the same", "conf": 0.922, "box": [[177, 1228], [905, 1227], [905, 1264], [177, 1265]]}, {"text": "number of erasers let's say 2, on both sides.", "conf": 0.873, "box": [[176, 1285], [876, 1283], [876, 1323], [176, 1325]]}, {"text": "We can see that the equation is still \"balanced.\"", "conf": 0.906, "box": [[173, 1358], [932, 1357], [932, 1394], [173, 1395]]}, {"text": "2+3", "conf": 0.723, "box": [[1168, 1393], [1264, 1393], [1264, 1428], [1168, 1428]]}, {"text": "Both sides have equal erasers i.e. 7.", "conf": 0.879, "box": [[175, 1418], [747, 1415], [747, 1451], [176, 1455]]}, {"text": "What will happen if we add 2 erasers to only", "conf": 0.9, "box": [[173, 1469], [890, 1472], [890, 1515], [172, 1512]]}, {"text": "one sideof the scale?Will theequalitystill be", "conf": 0.898, "box": [[174, 1531], [904, 1532], [904, 1569], [174, 1568]]}, {"text": "maintained? The answer is no. We must add", "conf": 0.885, "box": [[172, 1587], [884, 1585], [884, 1626], [172, 1628]]}, {"text": "the same amount on both sides to maintain", "conf": 0.891, "box": [[172, 1646], [881, 1646], [881, 1685], [172, 1685]]}, {"text": "the balance or equality.", "conf": 0.845, "box": [[172, 1704], [559, 1704], [559, 1744], [172, 1744]]}, {"text": "Same is the case for adding, subtracting,", "conf": 0.91, "box": [[172, 1755], [829, 1761], [829, 1807], [171, 1802]]}, {"text": "multiplying or dividing the number in", "conf": 0.928, "box": [[173, 1822], [783, 1817], [783, 1857], [174, 1862]]}, {"text": "equation. We must do the same operation on", "conf": 0.914, "box": [[172, 1874], [911, 1874], [911, 1924], [172, 1924]]}, {"text": "both sides of the equation to keep it equal.", "conf": 0.903, "box": [[170, 1931], [874, 1933], [874, 1980], [170, 1978]]}, {"text": "2+3+2", "conf": 0.773, "box": [[1098, 1939], [1261, 1944], [1260, 1978], [1097, 1974]]}, {"text": "5+2", "conf": 0.734, "box": [[1409, 1937], [1505, 1929], [1508, 1968], [1413, 1976]]}, {"text": "NNOTORSAE", "conf": 0.769, "box": [[201, 2027], [550, 2023], [550, 2059], [202, 2064]]}, {"text": "131", "conf": 0.737, "box": [[855, 2040], [920, 2040], [920, 2082], [855, 2082]]}]}