{"file": "D:\\SpaceBook\\Books\\6th\\Math\\JPG\\145.jpg", "lines": [{"text": "Example2:", "conf": 0.86, "box": [[183, 106], [370, 90], [374, 130], [186, 146]]}, {"text": "Solution:", "conf": 0.88, "box": [[177, 254], [332, 243], [335, 280], [179, 291]]}, {"text": "Perimeter of a square = 4 × L", "conf": 0.874, "box": [[170, 310], [633, 262], [638, 304], [175, 353]]}, {"text": "Perimeter=40cm", "conf": 0.92, "box": [[1285, 307], [1538, 324], [1535, 364], [1282, 347]]}, {"text": "'As perimeter is given and we need to find the length, so we put", "conf": 0.923, "box": [[158, 358], [1203, 253], [1208, 306], [164, 411]]}, {"text": "the value of perimeter in this formula.", "conf": 0.896, "box": [[161, 417], [761, 355], [765, 401], [166, 462]]}, {"text": "40cm=4×L", "conf": 0.835, "box": [[163, 473], [370, 456], [373, 493], [166, 510]]}, {"text": "Divide both sides by 4", "conf": 0.892, "box": [[157, 530], [511, 500], [515, 540], [160, 570]]}, {"text": "QuickCheck", "conf": 0.897, "box": [[1099, 580], [1314, 574], [1315, 610], [1100, 616]]}, {"text": "10", "conf": 0.565, "box": [[154, 646], [194, 646], [194, 681], [154, 681]]}, {"text": "Find the perimeter of a square if", "conf": 0.89, "box": [[1096, 649], [1544, 656], [1543, 699], [1095, 692]]}, {"text": "40 cm = 4×L = 10 cm = L", "conf": 0.884, "box": [[143, 669], [634, 651], [636, 710], [145, 729]]}, {"text": "the length of one side is 4.5 m.", "conf": 0.91, "box": [[1094, 699], [1528, 703], [1527, 746], [1093, 742]]}, {"text": "So, the length of the side of the square is 10 cm.", "conf": 0.923, "box": [[136, 787], [923, 722], [927, 765], [139, 830]]}, {"text": "8.1.2PerimeterofRectangle", "conf": 0.934, "box": [[127, 914], [699, 873], [702, 917], [130, 958]]}, {"text": "the width, we can write the perimeter as:", "conf": 0.879, "box": [[118, 1094], [784, 1053], [787, 1093], [121, 1134]]}, {"text": "Perimeter of a rectangle = length + length + width + width", "conf": 0.913, "box": [[105, 1239], [1113, 1180], [1116, 1226], [108, 1285]]}, {"text": "= 2 × length + 2 × width", "conf": 0.836, "box": [[106, 1305], [501, 1284], [503, 1327], [108, 1348]]}, {"text": "= 2 (length + width)", "conf": 0.933, "box": [[101, 1370], [424, 1353], [427, 1400], [103, 1417]]}, {"text": "= 2 (L + W)", "conf": 0.796, "box": [[96, 1434], [282, 1428], [283, 1475], [97, 1481]]}, {"text": "Example 1:", "conf": 0.824, "box": [[87, 1527], [278, 1520], [280, 1568], [88, 1575]]}, {"text": "Find the perimeter of the rectangle if its length is 15 cm and width is 12 cm.", "conf": 0.912, "box": [[76, 1590], [1402, 1532], [1405, 1593], [79, 1652]]}, {"text": "Solution:", "conf": 0.883, "box": [[80, 1657], [238, 1655], [239, 1696], [81, 1698]]}, {"text": "15cm", "conf": 0.651, "box": [[1237, 1683], [1341, 1674], [1345, 1716], [1241, 1725]]}, {"text": "Perimeter of rectangle = 2 (length + width)", "conf": 0.884, "box": [[76, 1724], [798, 1707], [799, 1753], [77, 1770]]}, {"text": "12 cm", "conf": 0.821, "box": [[1500, 1766], [1561, 1759], [1566, 1799], [1504, 1806]]}, {"text": "= 2 (15 cm + 12 cm)", "conf": 0.861, "box": [[506, 1788], [859, 1781], [860, 1824], [507, 1830]]}, {"text": "12 cm", "conf": 0.72, "box": [[984, 1811], [1085, 1809], [1086, 1848], [985, 1850]]}, {"text": "= 2 × 27 cm", "conf": 0.776, "box": [[504, 1858], [709, 1858], [709, 1899], [504, 1899]]}, {"text": "= 54 cm", "conf": 0.866, "box": [[498, 1926], [645, 1930], [644, 1975], [497, 1971]]}, {"text": "15 cm", "conf": 0.762, "box": [[1237, 1930], [1338, 1920], [1342, 1962], [1241, 1973]]}, {"text": "So, the perimeter of the rectangle is 54 cm.", "conf": 0.916, "box": [[61, 2000], [788, 2002], [788, 2048], [61, 2046]]}, {"text": "boardandaskthemtofindtheperimeter,", "conf": 0.942, "box": [[190, 2184], [773, 2197], [772, 2234], [189, 2221]]}]}