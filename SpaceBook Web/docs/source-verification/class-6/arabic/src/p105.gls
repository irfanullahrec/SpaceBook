## اَلدَّرْسُ الْعَاشِرُ || Lesson 10 || لسم لوست
g مُفَكِّرٌ = خیال پیش کرنے والا، سوچنے والا = thinker = مفکر
g ظِلٌّ = سایہ = shade = سیوری
g ثَانَوِيَّةٌ = ہائی، ثانوی = secondary (school) = ثانوي
g نَتَكَلَّمُ = ہم بات کریں گے = we (shall) talk = خبرې کوو
g بَارِعٌ = عمدہ = skilled, excellent = ماهر
g مَاجِسْتِيْرُ = ایم اے = master's degree = ماسټري
g اَلدُّكْتُوْرَاهُ = ڈاکٹریٹ، پی ایچ ڈی = doctorate, PhD = دوکتورا
g شَهَادَةٌ = ڈگری، سند = degree, certificate = سند
g مُحَامَاةٌ = وکالت = the law (profession) = وکالت
g اُوْرُبَّا = یورپ = Europe = اروپا
g مِهْنَةٌ = پیشہ = profession = مسلک
g مَرْقَدٌ = مزار = tomb, resting place = مزار
g دَافَعَ = حفاظت کی، دفاع کیا = he defended = دفاع یې وکړه
g تُوُفِّيَ = وہ وفات پا گیا = he died = وفات شو
g اَحْسَنْتُمْ = تم سب کو شاباش ہو = well done (you all) = شاباش (ټولو ته)
