## اَلدَّرْسُ التَّاسِعُ || Lesson 9 || نهم لوست
g حَوْلَ الْمَائِدَةِ = دسترخوان پر = around the table = د دسترخوان شاوخوا
g تَفَضَّلْ = آئیے، لیجیے، تناول کیجیے = please (come / take / eat) = راشئ، واخلئ
g جَاهِزٌ = تیار = ready = تیار
g طَيِّبٌ = ٹھیک ہے = fine, good = ښه ده
g بُنَيَّ = میرے چھوٹے بیٹے = my little son = زما زویکه
g عَدَسٌ = مسور، دال = lentils = دال
g اَللَّحْمُ = گوشت = meat = غوښه
g خُضَارٌ = سبزیاں = vegetables = سابه
g عَشَاءٌ = رات کا کھانا = supper = ماښامنۍ
g خَفِيْفٌ = ہلکا = light = سپک
g صَحْنٌ = پلیٹ = plate = بشقاب
g سَلَطَةٌ = سلاد = salad = سلاته
g سَمِّ اللّٰهَ = بسم اللہ پڑھو = say Bismillah = بسم الله ووایه
g يَمِيْنٌ = دایاں ہاتھ = right hand = ښی لاس
