## اَلدَّرْسُ الْحَادِيْ وَالْعِشْرُوْنَ || Lesson 21 || یوویشتم لوست
g مَمَرُّ خَيْبَرَ = درۂ خیبر = the Khyber Pass = د خیبر دره
g ضَيِّقٌ = تنگ = narrow = تنګ
g مَسَافَةٌ = فاصلہ = distance = واټن
g يَرْتَفِعُ = بلند ہوتا جاتا ہے، چڑھتا ہے = rises, climbs = لوړېږي
g تَدْرِيْجِيًّا = آہستہ آہستہ = gradually = ورو ورو
g كِيْلُوْمِتْرًا = کلومیٹر = kilometre(s) = کیلومتره
g اَرْفَعُ = بلند ترین = highest = تر ټولو لوړ
g سَفْحٌ = دامن = foot (of a mountain) = لمن
g حَدٌّ دَوْلِيٌّ = بین الاقوامی سرحد = international border = نړیواله پوله
g جَاوَزَهٗ = اسے عبور کیا = he crossed it = ترې تېر شو
