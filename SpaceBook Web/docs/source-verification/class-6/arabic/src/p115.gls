## اَلدَّرْسُ الْعِشْرُوْنَ || Lesson 20 || شلم لوست
g لُقِّبَ = لقب دیا گیا = he was given the title = لقب ورکړل شو
g اَلرُّوْحِيُّ = روحانی = spiritual = روحاني
g قَسَّمَ = تقسیم کیے = he distributed = ووېشل
g تَوَجَّهَ = رخ کیا، متوجہ ہوا = he turned towards = مخ یې کړ
g مُرْشِدٌ = صاحبِ ارشاد، مربی = spiritual guide = مرشد
g عَكَفَ = چلہ کاٹا، اعتکاف کیا = he stayed in devotion = اعتکاف یې وکړ
g مَكَثَ = ٹھہرا = he stayed = پاتې شو
g اَسْلَمَ = اسلام قبول کیا = he embraced Islam = مسلمان شو
g اَقَامَ = ٹھہرا، قیام کیا = he resided = اوسېد
g مَزَارٌ = زیارت گاہ = shrine = زیارت
g سُلْطَانُ الْهِنْدِ = شاہِ ہندوستان = Sultan of India = د هند سلطان
g هَنَادِكَةٌ = ہندو لوگ = Hindus = هندوان
g ضَرِيْحٌ = قبر = tomb, shrine = مزار
g بِيْئَةٌ رُوْحِيَّةٌ = روحانی ماحول = spiritual surroundings = روحاني چاپېریال
g مَقْبَرَتُهٗ = ان کا مزار = his tomb = د هغه مزار
