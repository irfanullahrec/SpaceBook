994, 1313], [993, 1337], [828, 1332]]}, {"text": "the highest positions in the society. The second level of", "conf": 0.912, "box": [[91, 1322], [743, 1319], [743, 1352], [92, 1355]]}, {"text": "hierarchy consisted of government officials and", "conf": 0.891, "box": [[90, 1355], [724, 1351], [724, 1387], [91, 1391]]}, {"text": "Scribes,Merchants", "conf": 0.907, "box": [[832, 1354], [995, 1358], [994, 1382], [831, 1378]]}, {"text": "andArtisans", "conf": 0.862, "box": [[859, 1375], [968, 1378], [967, 1399], [858, 1395]]}, {"text": "priests. The third tier included scribes, merchants", "conf": 0.938, "box": [[90, 1389], [707, 1381], [708, 1420], [91, 1429]]}, {"text": "Farmers", "conf": 0.87, "box": [[875, 1408], [952, 1412], [951, 1437], [874, 1433]]}, {"text": "and Artisans. The farmers and slaves made up the", "conf": 0.933, "box": [[89, 1425], [686, 1416], [687, 1452], [90, 1460]]}, {"text": "and Slaves", "conf": 0.817, "box": [[867, 1433], [958, 1433], [958, 1454], [867, 1454]]}, {"text": "lowest rank in this hierarchy.'", "conf": 0.892, "box": [[90, 1462], [452, 1453], [452, 1486], [91, 1494]]}, {"text": "System of Social Hierarchy in Sumer", "conf": 0.886, "box": [[783, 1486], [1076, 1491], [1076, 1514], [783, 1509]]}]}