, 768], [134, 772]]}, {"text": "to show that something continued for some time", "conf": 0.88, "box": [[136, 786], [717, 783], [717, 813], [136, 816]]}, {"text": "for something that happened again and again", "conf": 0.863, "box": [[136, 831], [680, 828], [681, 858], [136, 861]]}, {"text": "1Complete the sentences in the past continuous tense. The first one is done for you", "conf": 0.905, "box": [[97, 893], [1193, 882], [1193, 914], [98, 925]]}, {"text": "I_was_ (was/were)_creating_ (create) amazing models out of sand and water", "conf": 0.93, "box": [[133, 950], [1092, 937], [1092, 969], [133, 983]]}, {"text": "before this job.", "conf": 0.883, "box": [[139, 1007], [314, 1003], [314, 1037], [140, 1040]]}, {"text": "He__ (was/were)", "conf": 0.874, "box": [[131, 1064], [384, 1061], [385, 1094], [131, 1097]]}, {"text": "(make) money by winning competitions in sculpting", "conf": 0.907, "box": [[508, 1058], [1146, 1050], [1147, 1084], [508, 1092]]}, {"text": "during winter break.", "conf": 0.881, "box": [[139, 1124], [373, 1119], [374, 1152], [140, 1157]]}, {"text": "They", "conf": 0.767, "box": [[134, 1177], [200, 1181], [198, 1218], [132, 1214]]}, {"text": "(was/were)", "conf": 0.857, "box": [[320, 1178], [453, 1175], [453, 1208], [320, 1211]]}, {"text": "(complete) their models in less than 24 hours.", "conf": 0.937, "box": [[580, 1174], [1148, 1161], [1149, 1193], [581, 1206]]}, {"text": "(was/were)", "conf": 0.88, "box": [[344, 1236], [476, 1236], [476, 1267], [344, 1267]]}, {"text": "An airline", "conf": 0.834, "box": [[133, 1238], [260, 1238], [260, 1269], [133, 1269]]}, {"text": "(pay) for sculptors to create sand", "conf": 0.873, "box": [[635, 1232], [1049, 1221], [1050, 1253], [635, 1263]]}, {"text": "passengers jetting as marketing campaign every year.", "conf": 0.88, "box": [[139, 1300], [759, 1289], [759, 1319], [139, 1330]]}, {"text": "(fly) a commercial balloon for the last many", "conf": 0.933, "box": [[595, 1344], [1144, 1336], [1145, 1372], [596, 13