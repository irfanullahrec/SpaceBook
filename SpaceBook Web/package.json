{
  "name": "spacebook-dev-tests",
  "private": true,
  "description": "Dev-only test tooling for SpaceBook. Nothing here is shipped: deploy.yml excludes package*.json, node_modules and tests/.",
  "scripts": {
    "validate": "node tools/validate.js",
    "smoke": "node --max-old-space-size=8192 tools/smoke.js",
    "baseline": "node --max-old-space-size=8192 tests/baseline/run.js",
    "test": "npm run validate && npm run smoke",
    "test:php": "php tests/php/run.php",
    "lint:php": "node tools/php74_lint.js",
    "test:games": "node tests/games/content.js && node tests/games/browser.js",
    "test:sync": "node tests/sync/unit.js && node tests/sync/e2e.js",
    "build:lazy": "node tools/build/make_lazy.js",
    "check:lazy": "node tools/build/make_lazy.js --check",
    "parity:lazy": "node --max-old-space-size=8192 tools/build/lazy_parity.js"
  },
  "devDependencies": {
    "axe-core": "4.10.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.1",
    "playwright": "1.63.0"
  }
}
